<?xml version="1.0" encoding="utf-8"?>
<!-- Gili's MSIX manifest (PRD 9.4, F-PUB-01). scripts/package.ps1 fills in {VERSION}; the Store replaces the publisher. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">
  <Identity Name="Gili" Publisher="CN=Gili Dev" Version="{VERSION}" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Gili</DisplayName>
    <PublisherDisplayName>Gili</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="Gili" Executable="Gili.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Gili" Description="A glass bar with an island at the top of the screen"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <!-- Start with Windows: the Run key is virtualised inside a package (PRD 9.4). -->
        <desktop:Extension Category="windows.startupTask" Executable="Gili.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="GiliStartup" Enabled="true" DisplayName="Gili" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- Windows only gives the Wi-Fi network name to apps with location access (F-RIGHT-02). -->
    <DeviceCapability Name="location" />
    <!-- The control islands switch the Wi-Fi and Bluetooth radios and list paired devices (F-RIGHT-10). -->
    <DeviceCapability Name="bluetooth" />
    <DeviceCapability Name="radios" />
  </Capabilities>
</Package>
