<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Gili.App.Controls"
                    xmlns:i="clr-namespace:Gili.App.Island">
    <!-- Island controls shared by the pages and cards, as the mockup draws them. -->

    <!-- Shown only when moving with the keyboard, like the mockup's :focus-visible outline (2 px blue). -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="9" BorderBrush="#0A84FF" BorderThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Switch (mockup .sw): 38 × 22, knob 18 px sliding 16 px on the pop curve. -->
    <Style x:Key="Switch" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="38" Height="22">
                        <Border x:Name="Track" CornerRadius="11" Background="#48484A" />
                        <Ellipse Width="18" Height="18" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="2,0,0,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="2" Direction="270" Opacity="0.3" />
                            </Ellipse.Effect>
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="Knob" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.26"
                                                         EasingFunction="{x:Static c:BezierEase.Pop}" />
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Background.Color" To="#30D158" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.26"
                                                         EasingFunction="{x:Static c:BezierEase.Pop}" />
                                        <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Background.Color" To="#48484A" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .pill: 36 px, radius 18, #2C2C2E, #3A3A3C on hover, 0.96 while pressed. -->
    <Style x:Key="Pill" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="#F5F5F7" />
        <Setter Property="Background" Value="#2C2C2E" />
        <Setter Property="Tag" Value="#3A3A3C" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Height="36" MinWidth="36" CornerRadius="18" Padding="14,0" Background="{TemplateBinding Background}"
                            RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .pill.pri: white with black text, #D1D1D6 on hover. -->
    <Style x:Key="PrimaryPill" TargetType="Button" BasedOn="{StaticResource Pill}">
        <Setter Property="Foreground" Value="#000000" />
        <Setter Property="Background" Value="#F5F5F7" />
        <Setter Property="Tag" Value="#D1D1D6" />
    </Style>

    <!-- .chip: padding 4 10, radius 12, #1C1C1E, #2C2C2E on hover, 12 px. -->
    <Style x:Key="Chip" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="#F5F5F7" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="12" Padding="10,4" Background="#1C1C1E">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#2C2C2E" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .seg: #1C1C1E radius 9 padding 2; items padding 4 10 radius 7, 12 px grey; the chosen one #3A3A3C white. -->
    <Style x:Key="Segments" TargetType="ListBox">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="#1C1C1E" CornerRadius="9" Padding="2" HorizontalAlignment="Left">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="OverridesDefaultStyle" Value="True" />
                    <Setter Property="Foreground" Value="#8E8E93" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bg" CornerRadius="7" Padding="10,4" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#3A3A3C" />
                                        <Setter Property="Foreground" Value="#F5F5F7" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .field: 32 px, radius 16, #1C1C1E, 13 px, placeholder #636366 (from HelpText); a 1 px #636366 ring when focused.
         Tag "Past" draws the yellow edge of a time that has gone today, "Invalid" a red one. -->
    <Style x:Key="Field" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="#F5F5F7" />
        <Setter Property="CaretBrush" Value="#F5F5F7" />
        <Setter Property="SelectionBrush" Value="#0A84FF" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Bg" Height="32" CornerRadius="16" Background="#1C1C1E" BorderBrush="Transparent" BorderThickness="1" Padding="13,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <TextBlock x:Name="Hint" Text="{Binding (AutomationProperties.HelpText), RelativeSource={RelativeSource TemplatedParent}}"
                                   Foreground="#636366" Margin="16,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#636366" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Past">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#FFD60A" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Invalid">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#FF453A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .pill.sm: 30 px, radius 15, padding 0 12, 13 px. -->
    <Style x:Key="SmallPill" TargetType="Button" BasedOn="{StaticResource Pill}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Height="30" CornerRadius="15" Padding="12,0" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .pill.pri.iconbtn in a form: a white 32 px circle holding the check. -->
    <Style x:Key="CheckPill" TargetType="Button" BasedOn="{StaticResource PrimaryPill}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Width="32" Height="32" CornerRadius="16" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .chk: 24 px circle with a 2 px #636366 edge; done fills green and the black check pops in (280 ms pop curve). -->
    <Style x:Key="CheckCircle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Width="24" Height="24" Background="Transparent">
                        <Ellipse x:Name="Ring" Stroke="#636366" StrokeThickness="2" Fill="Transparent" />
                        <c:IconView x:Name="Tick" Glyph="{StaticResource Icon.Check}" Foreground="#000000" Width="14" Height="14" StrokeThickness="3.2"
                                    Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <c:IconView.RenderTransform>
                                <ScaleTransform x:Name="TickScale" ScaleX="0.3" ScaleY="0.3" />
                            </c:IconView.RenderTransform>
                        </c:IconView>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Fill" Value="#30D158" />
                            <Setter TargetName="Ring" Property="Stroke" Value="#30D158" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.28"
                                                         EasingFunction="{x:Static c:BezierEase.Pop}" />
                                        <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.28"
                                                         EasingFunction="{x:Static c:BezierEase.Pop}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleX" To="0.3" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="TickScale" Storyboard.TargetProperty="ScaleY" To="0.3" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .tact button: 28 px circle, grey icon; #2C2C2E and white on hover. -->
    <Style x:Key="RowAction" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="#8E8E93" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Height="28" MinWidth="28" CornerRadius="14" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#2C2C2E" />
                            <Setter Property="Foreground" Value="#F5F5F7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Control islands (PRD 6.4, mockup .cv): sliders, the title icon tile, and list rows. -->
    <Style x:Key="SliderPart" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .cv input[type=range]: 4 px track, white up to the thumb and 16% white after; a 16 px white thumb, 1.15x while held. -->
    <Style x:Key="ControlSlider" TargetType="Slider">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="10" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <!-- The filled part; the Volume island empties it while muted (mockup renderVol). -->
        <Setter Property="Foreground" Value="#F5F5F7" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="16" Background="Transparent">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderPart}" Background="{TemplateBinding Foreground}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderPart}" Background="#29FFFFFF" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="Knob" Fill="#FFFFFF" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.45" />
                                                </Ellipse.Effect>
                                                <Ellipse.RenderTransform>
                                                    <ScaleTransform x:Name="Grow" />
                                                </Ellipse.RenderTransform>
                                            </Ellipse>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1.15" Duration="0:0:0.12" EasingFunction="{x:Static c:BezierEase.Out}" />
                                                                <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1.15" Duration="0:0:0.12" EasingFunction="{x:Static c:BezierEase.Out}" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12" EasingFunction="{x:Static c:BezierEase.Out}" />
                                                                <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12" EasingFunction="{x:Static c:BezierEase.Out}" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .cv .qi: the title's 28 px tile, radius 9, white 8%; blue with a white icon while its radio is on. -->
    <Style x:Key="ControlTile" TargetType="Border">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Background" Value="#14FFFFFF" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- button.qi (the Volume island's speaker): the same tile, white 14% on hover. -->
    <Style x:Key="ControlTileButton" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="#F5F5F7" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Width="28" Height="28" CornerRadius="9" Background="#14FFFFFF">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#24FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .cv .qn: a list row, 36 px, radius 8, white 8% on hover. -->
    <Style x:Key="ControlRow" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="#F5F5F7" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" MinHeight="36" CornerRadius="8" Background="Transparent" Padding="10,0">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- .cv .qlist: white 5%, radius 12, 4 px inside, rows 2 apart, scrolling past 232 px. -->
    <Style x:Key="ControlList" TargetType="Border">
        <Setter Property="Background" Value="#0DFFFFFF" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <!-- .cvoff: the line that replaces a list while its radio is off. -->
    <Style x:Key="ControlOff" TargetType="TextBlock">
        <Setter Property="Margin" Value="10,12" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#8E8E93" />
    </Style>

    <!-- A control island's list row: icon, name (semibold while active), and the status (accent while active) or a check. -->
    <BooleanToVisibilityConverter x:Key="RowVisibleWhen" />
    <DataTemplate x:Key="ControlRowTemplate" DataType="{x:Type i:ControlRowItem}">
        <Button Style="{StaticResource ControlRow}" Margin="0,1" AutomationProperties.Name="{Binding Spoken}">
            <DockPanel>
                <c:IconView DockPanel.Dock="Left" Glyph="{Binding Glyph}" Width="15" Height="15" Foreground="#8E8E93" Margin="0,0,12,0" />
                <Grid DockPanel.Dock="Right" Margin="12,0,0,0">
                    <TextBlock x:Name="Status" Text="{Binding Status}" FontSize="12" Foreground="#8E8E93"
                               Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                    <c:IconView Glyph="{StaticResource Icon.Check}" Width="15" Height="15" Foreground="#30D158"
                                Visibility="{Binding Check, Converter={StaticResource RowVisibleWhen}}" />
                </Grid>
                <TextBlock x:Name="Name" Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Active}" Value="True">
                <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                <Setter TargetName="Status" Property="Foreground" Value="#30D158" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Back to island on a floating note (mockup .fhd button): 20 × 20, radius 8, a 12 px icon at white 55%;
         white 12% behind it and a white icon on hover. -->
    <Style x:Key="FloatingNoteBack" TargetType="Button">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Foreground" Value="#8CFFFFFF" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Width="20" Height="20" CornerRadius="8" Background="Transparent">
                        <c:IconView Glyph="{StaticResource Icon.IntoIsland}" Width="12" Height="12" StrokeThickness="2.4"
                                    Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1FFFFFFF" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A floating note's text (mockup .fnote textarea): no box, padding 0 14 12, line height 1.55, a thin dark
         scroll bar in the right padding. -->
    <Style x:Key="FloatingNoteText" TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="CaretBrush" Value="#F5F5F7" />
        <Setter Property="SelectionBrush" Value="#0A84FF" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="False" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <!-- The text view keeps 2 px on each side of its own, so 12 + 2 = the mockup's 14. -->
                    <ScrollViewer x:Name="PART_ContentHost" Margin="12,0,12,12" Focusable="False" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Template>
                            <ControlTemplate TargetType="ScrollViewer">
                                <Grid>
                                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" />
                                    <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Margin="0,0,-10,0" Width="8" MinWidth="8"
                                               OverridesDefaultStyle="True"
                                               Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                               Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}">
                                        <ScrollBar.Template>
                                            <ControlTemplate TargetType="ScrollBar">
                                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                    <Track.Thumb>
                                                        <Thumb>
                                                            <Thumb.Template>
                                                                <ControlTemplate TargetType="Thumb">
                                                                    <Border Width="6" CornerRadius="3" Background="#40FFFFFF" />
                                                                </ControlTemplate>
                                                            </Thumb.Template>
                                                        </Thumb>
                                                    </Track.Thumb>
                                                </Track>
                                            </ControlTemplate>
                                        </ScrollBar.Template>
                                    </ScrollBar>
                                </Grid>
                            </ControlTemplate>
                        </ScrollViewer.Template>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
