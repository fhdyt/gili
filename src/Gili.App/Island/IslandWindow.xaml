<Window x:Class="Gili.App.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Gili.App.Controls"
        xmlns:m="clr-namespace:Gili.App.Mascot"
        xmlns:i="clr-namespace:Gili.App.Island"
        xmlns:gm="clr-namespace:Gili.Core.Mascot;assembly=Gili.Core"
        Title="Gili Island" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#F5F5F7">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />
        <c:VisibleWhenFalse x:Key="VisibleWhenFalse" />
        <Style x:Key="SlotButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="20" Height="20" CornerRadius="10" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2C2C2E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Canvas>
        <!-- The floating shadows sit on their own plates so the island's text is never rendered through an effect. The
             mockup's two shadows (0 22 44 -14 black 70%, 0 8 18 -10 black 50%) become plates inset by their spread. -->
        <Border x:Name="ShadowPlate" Background="#000000" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="44" ShadowDepth="22" Direction="270" Opacity="0.7" Color="Black" />
            </Border.Effect>
        </Border>
        <Border x:Name="ShadowPlateNear" Background="#000000" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="8" Direction="270" Opacity="0.5" Color="Black" />
            </Border.Effect>
        </Border>

        <Border x:Name="Body" Background="#000000"
                MouseLeftButtonUp="OnBodyClick" MouseEnter="OnBodyEnter" MouseLeave="OnBodyLeave">
            <Grid>
                <!-- Behind everything, clipped by the island's shape: the open page's colour, drifting (PRD 6.3). -->
                <i:AmbientGlow x:Name="Glow" />

                <!-- Thin light line along the top edge while floating, so the black panel stands apart from dark windows. -->
                <Border x:Name="TopHighlight" BorderBrush="#17FFFFFF" BorderThickness="0,1,0,0" Opacity="0" IsHitTestVisible="False" />

                <!-- Gili in the idle island: the eyes travel the island 9 px from its ends (PRD 6.3 "Maskot Gili"). -->
                <m:GiliEyes x:Name="GiliInside" Form="{x:Static gm:GiliForm.InIsland}" IslandHeight="{Binding IslandHeight}"
                            Margin="9,0" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,0.5" />

                <!-- Layers are wider than the island and centred, so measuring their content never depends on the animated width. -->
                <Grid x:Name="CompactLayer" Width="760" HorizontalAlignment="Center" TextElement.FontSize="{Binding FontSize}">
                    <Grid x:Name="CompactContent" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Activities span at least the 200 px island edge to edge: icon left, value right (PRD 6.3). -->
                        <Grid Visibility="{Binding ShowMediaSlot, Converter={StaticResource VisibleWhen}}">
                            <!-- Music: artwork, title, level meter, play/pause, spread end to end (mockup .slot). -->
                            <Grid MinWidth="172" Visibility="{Binding IsMusic, Converter={StaticResource VisibleWhen}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Artwork past the island's corner arc: a 5 px radius and a faint white edge (PRD 6.3 "Artwork musik"). -->
                                <Border Width="{Binding ArtworkSize}" Height="{Binding ArtworkSize}" CornerRadius="5" Background="#1C1C1E">
                                    <Grid>
                                        <c:IconView Glyph="{StaticResource Icon.Music}" Width="11" Height="11" Foreground="#8E8E93" />
                                        <Border CornerRadius="5" Visibility="{Binding HasArtwork, Converter={StaticResource VisibleWhen}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="5" BorderBrush="#24FFFFFF" BorderThickness="0.5" />
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding MediaSlotTitle}" VerticalAlignment="Center" />
                                <c:LevelMeter Grid.Column="4" IsPlaying="{Binding IsPlaying}" BarBrush="{Binding LevelBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="6" Style="{StaticResource SlotButton}" Click="OnPlayPause"
                                        AutomationProperties.Name="Play or pause">
                                    <Grid>
                                        <c:IconView Glyph="{StaticResource Icon.Pause}" Filled="True" Width="11" Height="11"
                                                    Visibility="{Binding IsPlaying, Converter={StaticResource VisibleWhen}}" />
                                        <c:IconView Glyph="{StaticResource Icon.Play}" Filled="True" Width="11" Height="11"
                                                    Visibility="{Binding IsPlaying, Converter={StaticResource VisibleWhenFalse}}" />
                                    </Grid>
                                </Button>
                            </Grid>
                            <DockPanel MinWidth="172" Visibility="{Binding IsVideo, Converter={StaticResource VisibleWhen}}">
                                <c:IconView DockPanel.Dock="Left" Glyph="{StaticResource Icon.Film}" Width="14" Height="14" Foreground="#FF9F0A" />
                                <Grid DockPanel.Dock="Right" Width="36" Height="3" Margin="6,0,0,0" VerticalAlignment="Center"
                                      Visibility="{Binding HasTimeline, Converter={StaticResource VisibleWhen}}">
                                    <Border Background="#3A3A3C" CornerRadius="1.5" />
                                    <Border Background="#F5F5F7" CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Progress}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding MediaSlotTitle}" Margin="6,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>

                        <DockPanel MinWidth="172" Visibility="{Binding ShowChargingSlot, Converter={StaticResource VisibleWhen}}">
                            <c:IconView DockPanel.Dock="Left" Glyph="{StaticResource Icon.Bolt}" Filled="True" Width="14" Height="14" Foreground="#30D158" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ChargePercent}" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                            <Border />
                        </DockPanel>

                        <!-- A timer, pomodoro or stopwatch: its icon at the left end, the time at the right (mockup ACT_ICON). -->
                        <DockPanel MinWidth="172" Visibility="{Binding ShowTimerSlot, Converter={StaticResource VisibleWhen}}">
                            <c:IconView DockPanel.Dock="Left" Glyph="{Binding TimerSlotGlyph}" Foreground="{Binding TimerSlotBrush}" Width="14" Height="14" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TimerSlotValue}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                            <Border />
                        </DockPanel>

                        <!-- A copy holds the slot for 3 s (PRD 6.3 "Cuplikan clipboard", mockup showClip): icon or thumbnail
                             at the left end, the text at the right end, or in the middle when an image's size follows it. -->
                        <Grid MinWidth="172" Background="Transparent" ToolTip="{Binding ClipTooltip}"
                              Visibility="{Binding ShowClipboardSlot, Converter={StaticResource VisibleWhen}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="6" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="6" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center">
                                <c:IconView Glyph="{Binding ClipGlyph}" Foreground="{Binding ClipBrush}" Width="14" Height="14"
                                            Visibility="{Binding HasClipThumb, Converter={StaticResource VisibleWhenFalse}}" />
                                <!-- Thumbnail 36 × 20, filled and cropped, with a faint white edge (mockup .thumb). -->
                                <Grid Width="36" Height="20" Visibility="{Binding HasClipThumb, Converter={StaticResource VisibleWhen}}">
                                    <Border CornerRadius="4">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ClipThumb}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="4" BorderBrush="#29FFFFFF" BorderThickness="1" />
                                </Grid>
                            </Grid>
                            <TextBlock Grid.Column="{Binding ClipTextColumn}" Text="{Binding ClipText}" MaxWidth="260"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding ClipDetail}" Foreground="#8E8E93"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="WideLayer" Width="760" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False"
                      TextElement.FontSize="{Binding FontSize}">
                    <StackPanel x:Name="WideContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <c:IconView Glyph="{StaticResource Icon.Bolt}" Filled="True" Width="14" Height="14" Margin="0,0,8,0"
                                    Foreground="{Binding WideIconBrush}" Visibility="{Binding WideHasIcon, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding WideText}" />
                        <TextBlock Visibility="{Binding HasWideValue, Converter={StaticResource VisibleWhen}}">
                            <Run Text=" · " /><Run Text="{Binding WideValue, Mode=OneWay}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" />
                        </TextBlock>
                    </StackPanel>
                </Grid>

                <!-- The open island (PRD 6.3): Gili, the icon tab menu, and the page. Width and height come from code. -->
                <Grid x:Name="ExpandedLayer" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                    <!-- Gili beside the menu: 14 px inset + 18 px radius = the island's 32 px, like the menu. -->
                    <Border x:Name="MenuGili" Width="36" Height="36" CornerRadius="18" Background="#1AFFFFFF"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0">
                        <m:GiliEyes x:Name="MenuGiliEyes" Form="{x:Static gm:GiliForm.Menu}" />
                    </Border>
                    <Border x:Name="Menu" Margin="56,14,14,0" Height="36" VerticalAlignment="Top" CornerRadius="18" Background="#1AFFFFFF" Padding="3"
                            MouseMove="OnMenuMouseMove" MouseLeave="OnMenuMouseLeave">
                        <Grid>
                            <!-- 3 px inset + 15 px radius = the menu's 18 px. -->
                            <Border x:Name="TabHighlight" HorizontalAlignment="Left" CornerRadius="15" Background="#24FFFFFF">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="TabHighlightShift" />
                                </Border.RenderTransform>
                            </Border>
                            <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
                        </Grid>
                    </Border>

                    <Canvas x:Name="PageArea" Margin="0,58,0,0" VerticalAlignment="Top" ClipToBounds="True" Background="Transparent"
                            MouseWheel="OnPagesWheel">
                        <StackPanel x:Name="PageTrack" Orientation="Horizontal">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="PageShift" />
                            </StackPanel.RenderTransform>
                        </StackPanel>
                    </Canvas>
                </Grid>

                <!-- A notification card (PRD 6.3): 560 × 104, as wide as the screen allows. -->
                <i:CardView x:Name="CardLayer" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" />

                <!-- A control island (PRD 6.4): one control alone, 16 px from every edge, without the menu or Gili. -->
                <Border x:Name="ControlLayer" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Opacity="0" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Border x:Name="Bubble" Background="#000000" RenderTransformOrigin="0.5,0.5" MouseLeftButtonUp="OnBubbleClick">
            <Grid>
                <c:IconView Glyph="{Binding BubbleGlyph}" Filled="{Binding BubbleFilled}" Foreground="{Binding BubbleBrush}" Width="13" Height="13"
                            Visibility="{Binding BubbleIsMusic, Converter={StaticResource VisibleWhenFalse}}" />
                <!-- Music as the second activity: its artwork as a circle, 3 px inside the bubble. -->
                <Grid Margin="3" Visibility="{Binding BubbleIsMusic, Converter={StaticResource VisibleWhen}}">
                    <Ellipse Fill="#1C1C1E" />
                    <c:IconView Glyph="{StaticResource Icon.Music}" Width="11" Height="11" Foreground="#8E8E93" />
                    <Ellipse Visibility="{Binding HasArtwork, Converter={StaticResource VisibleWhen}}">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Stroke="#24FFFFFF" StrokeThickness="0.5" />
                </Grid>
            </Grid>
        </Border>

        <!-- Gili's circle 6 px left of the island while an activity shows (PRD 6.3 "Maskot Gili"). -->
        <Border x:Name="GiliCircle" Background="#000000" RenderTransformOrigin="0.5,0.5" Opacity="0" IsHitTestVisible="False"
                MouseLeftButtonUp="OnBodyClick">
            <m:GiliEyes x:Name="GiliCircleEyes" Form="{x:Static gm:GiliForm.Circle}" IslandHeight="{Binding IslandHeight}" />
        </Border>
    </Canvas>
</Window>
