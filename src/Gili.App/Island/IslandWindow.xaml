<Window x:Class="Gili.App.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Gili.App.Controls"
        xmlns:m="clr-namespace:Gili.App.Mascot"
        xmlns:i="clr-namespace:Gili.App.Island"
        xmlns:gm="clr-namespace:Gili.Core.Mascot;assembly=Gili.Core"
        Title="Gili Island" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#F5F5F7"
        AllowDrop="True" DragEnter="OnFileDrag" DragOver="OnFileDrag" DragLeave="OnFileDragLeave" Drop="OnFileDrop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />
        <c:VisibleWhenFalse x:Key="VisibleWhenFalse" />
        <Style x:Key="SlotButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="20" Height="20" CornerRadius="10" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2C2C2E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Canvas>
        <!-- The floating island's two shadows (mockup: 0 22 44 -14 black 70%, 0 8 18 -10 black 50%), drawn without an
             effect, since effects in this layered window were rendered again on every frame of the glow (PRD 8.1). -->
        <c:SoftShadowView x:Name="Shadow" Opacity="0" IsHitTestVisible="False" />

        <Border x:Name="Body" Background="#000000"
                MouseLeftButtonUp="OnBodyClick" MouseRightButtonUp="OnBodyRightClick" MouseEnter="OnBodyEnter" MouseLeave="OnBodyLeave">
            <Grid>
                <!-- Behind everything, clipped by the island's shape: the open page's colour, drifting (PRD 6.3). -->
                <i:AmbientGlow x:Name="Glow" />

                <!-- Thin light line along the top edge while floating, so the black panel stands apart from dark windows. -->
                <Border x:Name="TopHighlight" BorderBrush="#17FFFFFF" BorderThickness="0,1,0,0" Opacity="0" IsHitTestVisible="False" />

                <!-- Gili in the idle island: the eyes travel the island 9 px from its ends (PRD 6.3 "Maskot Gili"). -->
                <m:GiliEyes x:Name="GiliInside" Form="{x:Static gm:GiliForm.InIsland}" IslandHeight="{Binding IslandHeight}"
                            Margin="9,0" VerticalAlignment="Stretch" RenderTransformOrigin="0.5,0.5" />

                <!-- Layers are wider than the island and centred, so measuring their content never depends on the animated width. -->
                <Grid x:Name="CompactLayer" Width="760" HorizontalAlignment="Center" TextElement.FontSize="{Binding FontSize}">
                    <Grid x:Name="CompactContent" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Activities span at least the 200 px island edge to edge: icon left, value right (PRD 6.3). -->
                        <Grid Visibility="{Binding ShowMediaSlot, Converter={StaticResource VisibleWhen}}">
                            <!-- Music: artwork, title, level meter, play/pause, spread end to end (mockup .slot). -->
                            <Grid MinWidth="172" Visibility="{Binding IsMusic, Converter={StaticResource VisibleWhen}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="6" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Artwork past the island's corner arc: a 5 px radius and a faint white edge (PRD 6.3 "Artwork musik"). -->
                                <Border Width="{Binding ArtworkSize}" Height="{Binding ArtworkSize}" CornerRadius="5" Background="#1C1C1E">
                                    <Grid>
                                        <c:IconView Glyph="{StaticResource Icon.Music}" Width="11" Height="11" Foreground="#8E8E93" />
                                        <Border CornerRadius="5" Visibility="{Binding HasArtwork, Converter={StaticResource VisibleWhen}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="5" BorderBrush="#24FFFFFF" BorderThickness="0.5" />
                                    </Grid>
                                </Border>
                                <!-- The title, or the line being sung while lyrics are on (F-ISL-26); a new line rises 5 px as it fades in. -->
                                <TextBlock x:Name="SlotLyric" Grid.Column="2" Text="{Binding MediaSlotTitle}" ToolTip="{Binding MediaSlotTooltip}"
                                           VerticalAlignment="Center">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                                <c:LevelMeter Grid.Column="4" IsPlaying="{Binding IsPlaying}" BarBrush="{Binding LevelBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="6" Style="{StaticResource SlotButton}" Click="OnPlayPause"
                                        AutomationProperties.Name="Play or pause">
                                    <Grid>
                                        <c:IconView Glyph="{StaticResource Icon.Pause}" Filled="True" Width="11" Height="11"
                                                    Visibility="{Binding IsPlaying, Converter={StaticResource VisibleWhen}}" />
                                        <c:IconView Glyph="{StaticResource Icon.Play}" Filled="True" Width="11" Height="11"
                                                    Visibility="{Binding IsPlaying, Converter={StaticResource VisibleWhenFalse}}" />
                                    </Grid>
                                </Button>
                            </Grid>
                            <DockPanel MinWidth="172" Visibility="{Binding IsVideo, Converter={StaticResource VisibleWhen}}">
                                <!-- The video's thumbnail, 16:9 at the artwork's height, or a film glyph in the same box (issue #31). -->
                                <Border DockPanel.Dock="Left" Width="{Binding ThumbWidth}" Height="{Binding ArtworkSize}" CornerRadius="4" Background="#1C1C1E">
                                    <Grid>
                                        <c:IconView Glyph="{StaticResource Icon.Film}" Width="12" Height="12" Foreground="#FF9F0A" />
                                        <Border CornerRadius="4" Visibility="{Binding HasArtwork, Converter={StaticResource VisibleWhen}}">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="4" BorderBrush="#24FFFFFF" BorderThickness="0.5" />
                                    </Grid>
                                </Border>
                                <Grid DockPanel.Dock="Right" Width="36" Height="3" Margin="6,0,0,0" VerticalAlignment="Center"
                                      Visibility="{Binding HasTimeline, Converter={StaticResource VisibleWhen}}">
                                    <Border Background="#3A3A3C" CornerRadius="1.5" />
                                    <Border Background="#F5F5F7" CornerRadius="1.5" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="{Binding Progress}" />
                                        </Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding MediaSlotTitle}" Margin="6,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </DockPanel>
                        </Grid>

                        <DockPanel MinWidth="172" Visibility="{Binding ShowChargingSlot, Converter={StaticResource VisibleWhen}}">
                            <c:IconView DockPanel.Dock="Left" Glyph="{StaticResource Icon.Bolt}" Filled="True" Width="14" Height="14" Foreground="#30D158" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ChargePercent}" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                            <Border />
                        </DockPanel>

                        <!-- A timer, pomodoro or stopwatch: its icon at the left end, the time at the right (mockup ACT_ICON). -->
                        <DockPanel MinWidth="172" Visibility="{Binding ShowTimerSlot, Converter={StaticResource VisibleWhen}}">
                            <c:IconView DockPanel.Dock="Left" Glyph="{Binding TimerSlotGlyph}" Foreground="{Binding TimerSlotBrush}" Width="14" Height="14" />
                            <TextBlock x:Name="TimerSlotDigits" DockPanel.Dock="Right" Text="{Binding TimerSlotValue}" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                            <Border />
                        </DockPanel>

                        <!-- Claude (F-CLD-02, mockup clSlotHTML): its glyph, the session's name or the count, then Needs
                             input, Done · 4m 12s or the running time at the right. -->
                        <DockPanel MinWidth="172" Background="Transparent" ToolTip="{Binding ClaudeTooltip}"
                                   Visibility="{Binding ShowClaudeSlot, Converter={StaticResource VisibleWhen}}">
                            <!-- Another session finished unseen: a 5 px green dot ringed in black at the icon's top right (mockup .clp.dot). -->
                            <Grid DockPanel.Dock="Left" VerticalAlignment="Center">
                                <c:IconView x:Name="ClaudeSlotIcon" Glyph="{Binding ClaudeGlyph}" Filled="{Binding ClaudeFilled}"
                                            Foreground="{Binding ClaudeBrush}" Width="14" Height="14" />
                                <Ellipse Width="8" Height="8" Margin="0,-3.5,-4.5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="#30D158"
                                         Stroke="#000000" StrokeThickness="1.5" IsHitTestVisible="False"
                                         Visibility="{Binding ClaudeDot, Converter={StaticResource VisibleWhen}}" />
                            </Grid>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ClaudeRight}" Foreground="{Binding ClaudeRightBrush}" Margin="8,0,0,0"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ClaudeLeft}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- Claude's 5-hour window (F-CLD-08, mockup slotHTML 'lim'): the hourglass in Claude orange, or yellow once
                             the limit is reached, the label in grey and the time left at the right end. -->
                        <DockPanel MinWidth="172" Background="Transparent" ToolTip="{Binding UsageTooltip}"
                                   Visibility="{Binding ShowUsageSlot, Converter={StaticResource VisibleWhen}}">
                            <c:IconView DockPanel.Dock="Left" Glyph="{StaticResource Icon.Hourglass}" Foreground="{Binding UsageBrush}" Width="14" Height="14" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding UsageLeft}" Margin="8,0,0,0" Typography.NumeralAlignment="Tabular"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding UsageLabel}" Foreground="#8E8E93" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>

                        <!-- A copy holds the slot for 3 s (PRD 6.3 "Cuplikan clipboard", mockup showClip): icon or thumbnail
                             at the left end, the text at the right end, or in the middle when an image's size follows it. -->
                        <Grid MinWidth="172" Background="Transparent" ToolTip="{Binding ClipTooltip}"
                              Visibility="{Binding ShowClipboardSlot, Converter={StaticResource VisibleWhen}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="6" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="6" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Center">
                                <c:IconView Glyph="{Binding ClipGlyph}" Foreground="{Binding ClipBrush}" Width="14" Height="14"
                                            Visibility="{Binding HasClipThumb, Converter={StaticResource VisibleWhenFalse}}" />
                                <!-- Thumbnail 36 × 20, filled and cropped, with a faint white edge (mockup .thumb). -->
                                <Grid Width="36" Height="20" Visibility="{Binding HasClipThumb, Converter={StaticResource VisibleWhen}}">
                                    <Border CornerRadius="4">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ClipThumb}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="4" BorderBrush="#29FFFFFF" BorderThickness="1" />
                                </Grid>
                            </Grid>
                            <TextBlock Grid.Column="{Binding ClipTextColumn}" Text="{Binding ClipText}" MaxWidth="260"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding ClipDetail}" Foreground="#8E8E93"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Files waiting on the Shelf (issue 37, mockup slotHTML 'shelf'): the tray in the Shelf's blue at the
                             left end, the item's name or the file count, then the total size in grey at the right end. -->
                        <Grid MinWidth="172" Background="Transparent" ToolTip="{Binding ShelfSlotTooltip}"
                              Visibility="{Binding ShowShelfSlot, Converter={StaticResource VisibleWhen}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="6" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="6" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <c:IconView Glyph="{StaticResource Icon.Tray}" Foreground="#64D2FF" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="{Binding ShelfSlotTextColumn}" Text="{Binding ShelfSlotText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4" Text="{Binding ShelfSlotDetail}" Foreground="#8E8E93"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="WideLayer" Width="760" HorizontalAlignment="Center" Opacity="0" IsHitTestVisible="False"
                      TextElement.FontSize="{Binding FontSize}">
                    <StackPanel x:Name="WideContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <c:IconView Glyph="{Binding WideGlyph}" Filled="{Binding WideFilled}" Width="14" Height="14" Margin="0,0,8,0"
                                    Foreground="{Binding WideIconBrush}" Visibility="{Binding WideHasIcon, Converter={StaticResource VisibleWhen}}" />
                        <!-- The notice's pieces, one TextBlock per 8 px-spaced part, built in code from WideRuns. -->
                        <StackPanel x:Name="WideParts" Orientation="Horizontal" AutomationProperties.Name="{Binding WideName}" />
                    </StackPanel>
                </Grid>

                <!-- The open island (PRD 6.3): Gili, the icon tab menu, and the page. Width and height come from code. -->
                <Grid x:Name="ExpandedLayer" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False">
                    <!-- Gili beside the menu: 14 px inset + 18 px radius = the island's 32 px, like the menu. -->
                    <Border x:Name="MenuGili" Width="36" Height="36" CornerRadius="18" Background="#1AFFFFFF"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0">
                        <m:GiliEyes x:Name="MenuGiliEyes" Form="{x:Static gm:GiliForm.Menu}" />
                    </Border>
                    <Border x:Name="Menu" Margin="56,14,14,0" Height="36" VerticalAlignment="Top" CornerRadius="18" Background="#1AFFFFFF" Padding="3"
                            MouseMove="OnMenuMouseMove" MouseLeave="OnMenuMouseLeave">
                        <Grid>
                            <!-- 3 px inset + 15 px radius = the menu's 18 px. -->
                            <Border x:Name="TabHighlight" HorizontalAlignment="Left" CornerRadius="15" Background="#24FFFFFF">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="TabHighlightShift" />
                                </Border.RenderTransform>
                            </Border>
                            <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
                        </Grid>
                    </Border>

                    <Canvas x:Name="PageArea" Margin="0,58,0,0" VerticalAlignment="Top" ClipToBounds="True" Background="Transparent"
                            PreviewMouseWheel="OnPagesWheel">
                        <StackPanel x:Name="PageTrack" Orientation="Horizontal">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="PageShift" />
                            </StackPanel.RenderTransform>
                        </StackPanel>
                    </Canvas>
                </Grid>

                <!-- A notification card (PRD 6.3): 560 × 104, as wide as the screen allows. -->
                <i:CardView x:Name="CardLayer" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False" />

                <!--
                    The drop zone (mockup .dz): two dashed columns 10 px in, Copy on the left and Cut on the right (F-ISL-30),
                    each with its icon in a circle; a full Shelf shows one yellow message instead.
                -->
                <Grid x:Name="DropLayer" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0" IsHitTestVisible="False"
                      Background="Transparent">
                    <Grid x:Name="DropChoices" Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="DropCopy" Grid.Column="0">
                            <Rectangle x:Name="DropCopyOutline" RadiusX="20" RadiusY="20" StrokeThickness="1.5" StrokeDashArray="3 2" Stroke="#48484A" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid x:Name="DropCopyBadge" Width="36" Height="36" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse x:Name="DropCopyCircle" Fill="#1C1C1E" />
                                    <c:IconView x:Name="DropCopyIcon" Glyph="{StaticResource Icon.Files}" Width="18" Height="18" Foreground="#8E8E93" />
                                </Grid>
                                <TextBlock Text="Copy" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="Keeps the original where it is" FontSize="12" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="DropCut" Grid.Column="2">
                            <Rectangle x:Name="DropCutOutline" RadiusX="20" RadiusY="20" StrokeThickness="1.5" StrokeDashArray="3 2" Stroke="#48484A" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid x:Name="DropCutBadge" Width="36" Height="36" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse x:Name="DropCutCircle" Fill="#1C1C1E" />
                                    <c:IconView x:Name="DropCutIcon" Glyph="{StaticResource Icon.Scissors}" Width="18" Height="18" Foreground="#8E8E93" />
                                </Grid>
                                <TextBlock Text="Cut" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                <TextBlock Text="Moves it when you drag it out" FontSize="12" Foreground="#8E8E93" HorizontalAlignment="Center" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                    <Rectangle x:Name="DropOutline" Margin="10" RadiusX="22" RadiusY="22" StrokeThickness="1.5" StrokeDashArray="3 2"
                               Stroke="#FFD60A" Fill="Transparent" Visibility="Collapsed" />
                    <StackPanel x:Name="DropFull" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0"
                                Visibility="Collapsed">
                        <Grid x:Name="DropBadge" Width="48" Height="48" RenderTransformOrigin="0.5,0.5">
                            <Ellipse Fill="#1C1C1E" />
                            <c:IconView Glyph="{StaticResource Icon.TrayDown}" Width="24" Height="24" Foreground="#FFD60A" />
                        </Grid>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Shelf is full" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="Drag something out first" FontSize="13" Foreground="#8E8E93" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- A control island (PRD 6.4): one control alone, 16 px from every edge, without the menu or Gili. -->
                <Border x:Name="ControlLayer" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Top"
                        Opacity="0" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Border x:Name="Bubble" Background="#000000" RenderTransformOrigin="0.5,0.5" MouseLeftButtonUp="OnBubbleClick">
            <Grid>
                <Grid Width="13" Height="13" Visibility="{Binding BubbleIsMusic, Converter={StaticResource VisibleWhenFalse}}">
                    <c:IconView Glyph="{Binding BubbleGlyph}" Filled="{Binding BubbleFilled}" Foreground="{Binding BubbleBrush}" />
                    <Ellipse Width="8" Height="8" Margin="0,-3.5,-4.5,0" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="#30D158"
                             Stroke="#000000" StrokeThickness="1.5" IsHitTestVisible="False"
                             Visibility="{Binding BubbleDot, Converter={StaticResource VisibleWhen}}" />
                </Grid>
                <!-- Music as the second activity: its artwork as a circle, 3 px inside the bubble. -->
                <Grid Margin="3" Visibility="{Binding BubbleIsMusic, Converter={StaticResource VisibleWhen}}">
                    <Ellipse Fill="#1C1C1E" />
                    <c:IconView Glyph="{StaticResource Icon.Music}" Width="11" Height="11" Foreground="#8E8E93" />
                    <Ellipse Visibility="{Binding HasArtwork, Converter={StaticResource VisibleWhen}}">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Artwork}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Stroke="#24FFFFFF" StrokeThickness="0.5" />
                </Grid>
            </Grid>
        </Border>

        <!-- Claude's green bubble (F-CLD-04, mockup .bubble.cdone): a session finished while its window was behind. Right of
             every other bubble; a green badge counts more than one (mockup .bn). -->
        <Border x:Name="DoneBubble" Background="#000000" BorderBrush="#8030D158" BorderThickness="1.5" RenderTransformOrigin="0.5,0.5"
                MouseLeftButtonUp="OnDoneBubbleClick" ToolTip="{Binding DoneTooltip}" AutomationProperties.Name="{Binding DoneName}"
                IsHitTestVisible="False">
            <Grid>
                <c:IconView Glyph="{StaticResource Icon.Claude}" Filled="True" Foreground="#30D158" Width="13" Height="13" />
                <Border MinWidth="13" Height="13" Padding="3,0" CornerRadius="6.5" Background="#30D158" Margin="0,-4.5,-5.5,0"
                        HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False"
                        Visibility="{Binding HasDoneCount, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="{Binding DoneCount}" FontSize="9" FontWeight="Bold" Foreground="#000000" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                </Border>
            </Grid>
        </Border>

        <!-- Camera and microphone dots (PRD 6.3 "Indikator kamera dan mikrofon"): 8 px with a thin dark edge, in a 20 px
             area so the pointer finds them; the near-clear fill keeps that area hit-testable in the layered window. -->
        <Border x:Name="CameraDot" Width="20" Height="20" Background="#01000000" RenderTransformOrigin="0.5,0.5" Opacity="0"
                IsHitTestVisible="False" ToolTipService.InitialShowDelay="300">
            <Ellipse Width="8" Height="8" Fill="#30D158" Stroke="#59000000" StrokeThickness="1.5" />
        </Border>
        <Border x:Name="MicrophoneDot" Width="20" Height="20" Background="#01000000" RenderTransformOrigin="0.5,0.5" Opacity="0"
                IsHitTestVisible="False" ToolTipService.InitialShowDelay="300">
            <Ellipse Width="8" Height="8" Fill="#FF9F0A" Stroke="#59000000" StrokeThickness="1.5" />
        </Border>

        <!-- Gili's circle 6 px left of the island while an activity shows (PRD 6.3 "Maskot Gili"). -->
        <Border x:Name="GiliCircle" Background="#000000" RenderTransformOrigin="0.5,0.5" Opacity="0" IsHitTestVisible="False"
                MouseLeftButtonUp="OnBodyClick">
            <m:GiliEyes x:Name="GiliCircleEyes" Form="{x:Static gm:GiliForm.Circle}" IslandHeight="{Binding IslandHeight}" />
        </Border>
    </Canvas>
</Window>
