<UserControl x:Class="Gili.App.Island.ClipboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Gili.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />

        <!-- .cbtop .field: 32 px, radius 10, padding 0 12. -->
        <Style x:Key="SearchField" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Bg" Height="32" CornerRadius="10" Background="#1C1C1E" BorderBrush="Transparent" BorderThickness="1" Padding="11,0">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Border>
                            <TextBlock x:Name="Hint" Text="Search clipboard" Foreground="#636366" Margin="14,0" VerticalAlignment="Center"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#636366" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .cbtop .pill: 32 px, radius 10; red with white text while it asks (mockup .confirm). -->
        <Style x:Key="ClearButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Height="32" CornerRadius="10" Padding="12,0" Background="#2C2C2E">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3C" />
                            </Trigger>
                            <DataTrigger Binding="{Binding ConfirmingClear}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF453A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- .cbx: 28 px circle 8 px from the right, shown on hover or highlight; red on hover. -->
        <Style x:Key="RemoveButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="ToolTip" Value="Remove" />
            <Setter Property="AutomationProperties.Name" Value="Remove from history" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="28" Height="28" CornerRadius="14" Background="Transparent">
                            <c:IconView Glyph="{StaticResource Icon.Close}" Width="13" Height="13" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3C" />
                                <Setter Property="Foreground" Value="#FF453A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- .page.pg-clip: padding 2 24 4; the top row, 10 px, then the list, which alone scrolls once the island is screen-high. -->
    <Grid Margin="24,2,24,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,10">
            <Button DockPanel.Dock="Right" Style="{StaticResource ClearButton}" Content="{Binding ClearLabel}" Command="{Binding ClearCommand}"
                    Margin="8,0,0,0" Visibility="{Binding HasItems, Converter={StaticResource VisibleWhen}}" />
            <TextBox x:Name="Search" Style="{StaticResource SearchField}" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search clipboard" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel>
                <StackPanel Margin="2,8" Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}">
                    <TextBlock Text="Nothing copied yet" FontSize="13" Foreground="#8E8E93" />
                    <TextBlock Text="Text you copy shows up here" FontSize="12" Foreground="#636366" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Text="No matches" FontSize="13" Foreground="#8E8E93" Margin="2,8"
                           Visibility="{Binding NoMatches, Converter={StaticResource VisibleWhen}}" />
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False"
                              AutomationProperties.Name="Clipboard history. Pick an item to paste it where you were typing.">
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- .cbr: radius 12, #1C1C1E, #2C2C2E on hover or highlight, 6 px apart. -->
                            <Border x:Name="Row" CornerRadius="12" Background="#1C1C1E" Margin="0,0,0,6" ToolTip="{Binding Tooltip}" Cursor="Hand">
                                <Grid>
                                    <!-- .cbp: at least 44 px, 6 12 padding, 44 px kept free on the right for ×. -->
                                    <Button Command="{Binding PasteCommand}" AutomationProperties.Name="{Binding Text}" FocusVisualStyle="{StaticResource FocusRing}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <StackPanel MinHeight="44" Margin="12,6,44,6" VerticalAlignment="Center" Background="Transparent">
                                                    <TextBlock Text="{Binding Text}" FontSize="13.5" FontWeight="Medium" Foreground="#F5F5F7"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="#8E8E93" Margin="0,2,0,0"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="Remove" Style="{StaticResource RemoveButton}" Command="{Binding RemoveCommand}" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#2C2C2E" />
                                    <Setter TargetName="Remove" Property="Opacity" Value="1" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="#2C2C2E" />
                                    <Setter TargetName="Remove" Property="Opacity" Value="1" />
                                </DataTrigger>
                                <Trigger SourceName="Remove" Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Remove" Property="Opacity" Value="1" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
