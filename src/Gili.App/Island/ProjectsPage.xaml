<UserControl x:Class="Gili.App.Island.ProjectsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Gili.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />
        <c:VisibleWhenFalse x:Key="VisibleWhenFalse" />

        <!-- .pjform .field, .pjmenu .field: 32 px, radius 10, padding 0 12; the hint from HelpText; Tag "Invalid" draws a red edge. -->
        <Style x:Key="FormField" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="Bg" Height="32" CornerRadius="10" Background="#1C1C1E" BorderBrush="Transparent" BorderThickness="1" Padding="11,0">
                                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                            </Border>
                            <TextBlock x:Name="Hint" Text="{Binding (AutomationProperties.HelpText), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="#636366" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#636366" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Invalid">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#FF453A" />
                                <Setter TargetName="Bg" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A 32 px button with radius 10 (.pjtop .pill, .pjdl): #2C2C2E, #3A3A3C on hover. -->
        <Style x:Key="SquarePill" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="#2C2C2E" />
            <Setter Property="Tag" Value="#3A3A3C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Height="32" MinWidth="32" CornerRadius="10" Padding="12,0" Background="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The project's name (.pjsel): #1C1C1E, #2C2C2E on hover or while the list is open, 13.5 semibold, chevron down. -->
        <Style x:Key="ProjectSelect" TargetType="Button" BasedOn="{StaticResource SquarePill}">
            <Setter Property="Background" Value="#1C1C1E" />
            <Setter Property="Tag" Value="#2C2C2E" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- ‹ Today › (.pjnav button): transparent, grey; #2C2C2E and white on hover. -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Height="32" MinWidth="28" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2C2C2E" />
                                <Setter Property="Foreground" Value="#F5F5F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The check that saves (.pill.pri.iconbtn): white, 32 px, radius 10. -->
        <Style x:Key="SaveButton" TargetType="Button" BasedOn="{StaticResource SquarePill}">
            <Setter Property="Foreground" Value="#000000" />
            <Setter Property="Background" Value="#F5F5F7" />
            <Setter Property="Tag" Value="#D1D1D6" />
            <Setter Property="Width" Value="32" />
        </Style>

        <!-- Delete in the form (.pjdl): the trash, grey (red on hover); "Delete?" white on red for 3 s after the first click. -->
        <Style x:Key="DeleteTask" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="ToolTip" Value="Delete" />
            <Setter Property="AutomationProperties.Name" Value="Delete task" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Height="32" MinWidth="32" CornerRadius="10" Background="#2C2C2E">
                            <Grid>
                                <c:IconView x:Name="Trash" Glyph="{StaticResource Icon.Trash}" Width="14" Height="14" />
                                <TextBlock x:Name="Ask" Text="Delete?" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="10,0"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3C" />
                                <Setter Property="Foreground" Value="#FF453A" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsConfirmingDelete}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#FF453A" />
                                <Setter TargetName="Trash" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Ask" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A project in the list (.pjmn): the check on the one on show, the name, done/total. -->
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Height="34" Padding="8,0,6,0" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rename and Delete on a list row (.pjma button): 28 px, radius 9; Delete turns into "Delete?" on red. -->
        <Style x:Key="MenuAction" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Height="28" MinWidth="28" CornerRadius="9" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="#F5F5F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A colour swatch, as in the note editor: 20 px, a white ring with a black gap when picked. -->
        <Style x:Key="Swatch" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="FocusVisualStyle">
                <Setter.Value>
                    <Style>
                        <Setter Property="Control.Template">
                            <Setter.Value>
                                <ControlTemplate>
                                    <Ellipse Margin="-5" Stroke="#0A84FF" StrokeThickness="2" />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="20" Height="20" Background="Transparent">
                            <Ellipse x:Name="Outer" Margin="-4" Fill="#F5F5F7" Visibility="Collapsed" />
                            <Ellipse x:Name="Inner" Margin="-2" Fill="#000000" Visibility="Collapsed" />
                            <Ellipse Fill="{TemplateBinding Background}" />
                            <Ellipse Margin="0.5" Stroke="#33FFFFFF" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Inner" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Step one (mockup .pjempty): no project yet, so name one. -->
        <StackPanel Height="230" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding HasProject, Converter={StaticResource VisibleWhenFalse}}">
            <Border Width="44" Height="44" CornerRadius="22" Background="#385E5CE6" Margin="0,28,0,10" HorizontalAlignment="Center">
                <c:IconView Glyph="{StaticResource Icon.Gantt}" Width="20" Height="20" Foreground="#A5A4FF" />
            </Border>
            <TextBlock Text="Plan a project" FontSize="16" FontWeight="SemiBold" Foreground="#F5F5F7" HorizontalAlignment="Center" />
            <TextBlock Text="Name it, then add its tasks with dates. Drag them along the timeline as plans change." FontSize="12.5"
                       Foreground="#8E8E93" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="340" Margin="0,6,0,0" />
            <Grid Width="320" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FirstName" Style="{StaticResource FormField}" AutomationProperties.HelpText="Project name"
                         AutomationProperties.Name="Project name" MaxLength="60"
                         Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding CreateFirstCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <Button Grid.Column="1" Style="{StaticResource SaveButton}" Width="Auto" Margin="6,0,0,0" Content="Create"
                        FontSize="13" Command="{Binding CreateFirstCommand}" />
            </Grid>
        </StackPanel>

        <!-- A project: the top row, the task form, then the timeline down to the bottom edge; the project list floats over them. -->
        <Grid Visibility="{Binding HasProject, Converter={StaticResource VisibleWhen}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Height="32" Margin="24,2,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SelectButton" Style="{StaticResource ProjectSelect}" MaxWidth="210" Command="{Binding ToggleMenuCommand}"
                            ToolTip="Projects" AutomationProperties.Name="{Binding ProjectName}">
                        <StackPanel Orientation="Horizontal" Margin="12,0,10,0">
                            <TextBlock Text="{Binding ProjectName}" TextTrimming="CharacterEllipsis" MaxWidth="170" VerticalAlignment="Center" />
                            <c:IconView Glyph="{StaticResource Icon.ChevronDown}" Width="13" Height="13" Margin="6,0,0,0" Foreground="#8E8E93" />
                        </StackPanel>
                    </Button>
                    <TextBlock Grid.Column="1" Text="{Binding Meta}" FontSize="12" Foreground="#8E8E93" Margin="8,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Typography.NumeralAlignment="Tabular" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                        <Button Style="{StaticResource NavButton}" Click="OnPreviousWeek" ToolTip="Previous week" AutomationProperties.Name="Previous week">
                            <c:IconView Glyph="{StaticResource Icon.ChevronLeft}" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource NavButton}" Padding="10,0" Margin="2,0" Click="OnToday" Content="Today" />
                        <Button Style="{StaticResource NavButton}" Click="OnNextWeek" ToolTip="Next week" AutomationProperties.Name="Next week">
                            <c:IconView Glyph="{StaticResource Icon.ChevronRight}" Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                    <Button Grid.Column="3" Style="{StaticResource SquarePill}" Command="{Binding AddTaskCommand}">
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Glyph="{StaticResource Icon.Plus}" Width="14" Height="14" Margin="0,0,6,0" />
                            <TextBlock Text="Add task" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- The task form (.pjform), above the timeline so the timeline always ends at the bottom: name, start → end, Delete
                     when editing, the check; then the note colours. -->
                <StackPanel Grid.Row="1" Margin="24,10,24,0" Visibility="{Binding IsFormOpen, Converter={StaticResource VisibleWhen}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TaskTitle" Style="{StaticResource FormField}" MaxLength="80" Tag="{Binding TitleState}"
                                 AutomationProperties.HelpText="{Binding TitleHint}" AutomationProperties.Name="Task name"
                                 Text="{Binding FormTitle, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox x:Name="TaskStart" Grid.Column="1" Style="{StaticResource FormField}" Margin="6,0,0,0" Tag="{Binding StartState}"
                                 AutomationProperties.Name="Start date" ToolTip="{Binding EndHint}" PreviewKeyDown="OnDateKey"
                                 Text="{Binding FormStart, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Text="→" Foreground="#636366" FontSize="12" Margin="6,0" VerticalAlignment="Center" />
                        <TextBox x:Name="TaskEnd" Grid.Column="3" Style="{StaticResource FormField}" Tag="{Binding EndState}"
                                 AutomationProperties.Name="End date" ToolTip="{Binding EndHint}" PreviewKeyDown="OnDateKey"
                                 Text="{Binding FormEnd, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="4" Style="{StaticResource DeleteTask}" Margin="6,0,0,0" Command="{Binding DeleteTaskCommand}"
                                Visibility="{Binding IsEditing, Converter={StaticResource VisibleWhen}}" />
                        <Button Grid.Column="5" Style="{StaticResource SaveButton}" Margin="6,0,0,0" Command="{Binding SaveFormCommand}"
                                AutomationProperties.Name="{Binding SaveLabel}" ToolTip="{Binding SaveLabel}">
                            <c:IconView Glyph="{StaticResource Icon.Check}" Width="15" Height="15" StrokeThickness="2.6" />
                        </Button>
                    </Grid>
                    <StackPanel x:Name="Swatches" Orientation="Horizontal" Margin="2,10,0,0" AutomationProperties.Name="Task color" />
                </StackPanel>

                <!-- Flush with the island's left, right and bottom edges, filling the rest of the page (.pjtl). -->
                <c:ProjectTimeline x:Name="Timeline" Grid.Row="2" Margin="0,10,0,0" Tasks="{Binding Tasks}" Today="{Binding Today}"
                                   SelectedId="{Binding SelectedId}" ProjectKey="{Binding ProjectKey}" />
            </Grid>

            <!-- The project list (.pjmenu): under the name, over the timeline; 260 px, radius 16, #2C2C2E. -->
            <Border x:Name="Menu" Width="260" Margin="24,40,0,0" Padding="6" CornerRadius="16" Background="#2C2C2E" BorderBrush="#14FFFFFF"
                    BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Visibility="{Binding IsMenuOpen, Converter={StaticResource VisibleWhen}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding MenuItems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Border x:Name="Row" CornerRadius="10" Background="Transparent"
                                            Visibility="{Binding IsRenaming, Converter={StaticResource VisibleWhenFalse}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource MenuRow}" Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="21" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <c:IconView Glyph="{StaticResource Icon.Check}" Width="13" Height="13" Foreground="#30D158" HorizontalAlignment="Left"
                                                                Visibility="{Binding IsCurrent, Converter={StaticResource VisibleWhen}}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Progress}" FontSize="11.5" Foreground="#8E8E93" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                                </Grid>
                                            </Button>
                                            <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                                                <Button Style="{StaticResource MenuAction}" ToolTip="Rename" AutomationProperties.Name="{Binding Name, StringFormat=Rename {0}}"
                                                        Command="{Binding DataContext.StartRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <c:IconView Glyph="{StaticResource Icon.Pencil}" Width="13" Height="13" />
                                                </Button>
                                                <Button x:Name="Delete" Style="{StaticResource MenuAction}" ToolTip="Delete" AutomationProperties.Name="{Binding Name, StringFormat=Delete {0}}"
                                                        Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <Grid>
                                                        <c:IconView x:Name="Trash" Glyph="{StaticResource Icon.Trash}" Width="13" Height="13" />
                                                        <TextBlock x:Name="Ask" Text="Delete?" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="9,0"
                                                                   VerticalAlignment="Center" Visibility="Collapsed" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Grid Visibility="{Binding IsRenaming, Converter={StaticResource VisibleWhen}}" Margin="2,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Style="{StaticResource FormField}" Tag="Rename" MaxLength="60" AutomationProperties.Name="Project name"
                                                 Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}">
                                            <TextBox.InputBindings>
                                                <KeyBinding Key="Enter" Command="{Binding DataContext.SaveRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                            </TextBox.InputBindings>
                                        </TextBox>
                                        <Button Grid.Column="1" Style="{StaticResource SaveButton}" Margin="4,0,0,0" ToolTip="Rename" AutomationProperties.Name="Rename"
                                                Command="{Binding DataContext.SaveRenameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <c:IconView Glyph="{StaticResource Icon.Check}" Width="15" Height="15" StrokeThickness="2.6" />
                                        </Button>
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="#14FFFFFF" />
                                        <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <Trigger SourceName="Row" Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsConfirmingDelete}" Value="True">
                                        <Setter TargetName="Actions" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Trash" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="Ask" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Delete" Property="Background" Value="#FF453A" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Margin="6,4" Background="#1AFFFFFF" />
                    <Button Style="{StaticResource MenuRow}" Command="{Binding StartNewProjectCommand}"
                            Visibility="{Binding IsAddingProject, Converter={StaticResource VisibleWhenFalse}}">
                        <StackPanel Orientation="Horizontal">
                            <c:IconView Glyph="{StaticResource Icon.Plus}" Width="13" Height="13" Margin="0,0,8,0" />
                            <TextBlock Text="New project" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Grid Margin="2,1" Visibility="{Binding IsAddingProject, Converter={StaticResource VisibleWhen}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewProjectName" Style="{StaticResource FormField}" MaxLength="60" AutomationProperties.HelpText="Project name"
                                 AutomationProperties.Name="Project name" Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding CreateProjectCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Style="{StaticResource SaveButton}" Margin="4,0,0,0" ToolTip="Create project" AutomationProperties.Name="Create project"
                                Command="{Binding CreateProjectCommand}">
                            <c:IconView Glyph="{StaticResource Icon.Check}" Width="15" Height="15" StrokeThickness="2.6" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
