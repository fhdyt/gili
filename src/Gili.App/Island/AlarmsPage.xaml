<UserControl x:Class="Gili.App.Island.AlarmsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- The Alarms page (mockup section "Alarms"): the next alarm on the left, every alarm with its switch on the right. -->
    <DockPanel Margin="32,0" VerticalAlignment="Center">
        <!-- .alist: 300 px, rows 6 px apart. -->
        <ItemsControl DockPanel.Dock="Right" Width="300" ItemsSource="{Binding Rows}" VerticalAlignment="Center" Margin="24,0,0,0"
                      Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- .arow: #1C1C1E, radius 12, padding 7 12, 10 px between time, text and switch. -->
                    <Border Background="#1C1C1E" CornerRadius="12" Padding="12,7" Margin="0,0,0,6">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Width="52" Margin="0,0,10,0" Text="{Binding Time}" FontSize="17" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                            <ToggleButton DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource Switch}" IsChecked="{Binding IsOn}"
                                          VerticalAlignment="Center" AutomationProperties.Name="{Binding Time, StringFormat='Alarm {0}'}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#8E8E93" LineStackingStrategy="BlockLineHeight"
                                           LineHeight="15.6" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#8E8E93" LineStackingStrategy="BlockLineHeight"
                                           LineHeight="15.6" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Next alarm" FontSize="13" Foreground="#8E8E93" />
            <TextBlock Text="{Binding Big}" FontSize="44" FontWeight="Bold" Typography.NumeralAlignment="Tabular"
                       LineStackingStrategy="BlockLineHeight" LineHeight="47.5" />
            <TextBlock Text="{Binding Sub}" FontSize="13" Foreground="#8E8E93" TextTrimming="CharacterEllipsis" />
            <Button Style="{StaticResource Chip}" Content="Manage alarms" Margin="0,10,0,0" HorizontalAlignment="Left"
                    Command="{Binding ManageCommand}" />
        </StackPanel>
    </DockPanel>
</UserControl>
