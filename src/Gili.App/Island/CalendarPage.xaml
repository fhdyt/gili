<UserControl x:Class="Gili.App.Island.CalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Gili.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />

        <!-- A day (mockup .cal button): 19 px, radius 6, 11 px; today green with black bold text, picked #3A3A3C,
             a 3 px orange dot 1 px from the bottom (black on today). -->
        <Style x:Key="Day" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Height="19" CornerRadius="6" Background="Transparent">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse x:Name="Dot" Width="3" Height="3" Fill="#FF9F0A" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                         Visibility="{Binding HasDot, Converter={StaticResource VisibleWhen}}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1C1C1E" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3C" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#30D158" />
                                <Setter Property="Foreground" Value="#000000" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter TargetName="Dot" Property="Fill" Value="#000000" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Previous and next month: 20 px chevrons, grey, white on hover. -->
        <Style x:Key="MonthStep" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Width="20" Height="20" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#F5F5F7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- The Calendar page (mockup section "Calendar"): the month on the left, the picked day on the right, 24 px apart. -->
    <Grid Margin="32,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="0.001*" MinWidth="24" />
            <ColumnDefinition Width="1000*" MaxWidth="270" />
        </Grid.ColumnDefinitions>
        <!-- .cal: seven 30 px columns, 2 px apart. -->
        <StackPanel Width="224" VerticalAlignment="Center">
            <DockPanel Height="20" Margin="1,0,1,2">
                <Button DockPanel.Dock="Right" Style="{StaticResource MonthStep}" Command="{Binding NextMonthCommand}" AutomationProperties.Name="Next month">
                    <c:IconView Glyph="{StaticResource Icon.ChevronRight}" Width="12" Height="12" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource MonthStep}" Command="{Binding PreviousMonthCommand}" Margin="0,0,2,0"
                        AutomationProperties.Name="Previous month">
                    <c:IconView Glyph="{StaticResource Icon.ChevronLeft}" Width="12" Height="12" />
                </Button>
                <TextBlock Text="{Binding MonthTitle}" FontSize="13" FontWeight="SemiBold" Padding="4,0,0,0" VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding DayNames}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Height="16" Margin="1,0,1,2" FontSize="11" Foreground="#8E8E93" TextAlignment="Center"
                                   LineStackingStrategy="BlockLineHeight" LineHeight="16" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding Days}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="19" Margin="1,0,1,2">
                            <Button Style="{StaticResource Day}" Content="{Binding Text}" Command="{Binding PickCommand}"
                                    AutomationProperties.Name="{Binding Name}" Visibility="{Binding IsDay, Converter={StaticResource VisibleWhen}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- .cev: up to 270 px at the right, narrower when the island is (flex 0 1 270px); the island grows to show every item. -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding Heading}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Entries}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1C1C1E" CornerRadius="10" Padding="12,8" Margin="0,0,0,6">
                            <TextBlock x:Name="Text" Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis" />
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Done}" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Strikethrough" />
                                <Setter TargetName="Text" Property="Foreground" Value="#8E8E93" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Nothing scheduled." FontSize="12" Foreground="#8E8E93" Margin="0,0,0,8"
                       Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" />
            <TextBlock Text="{Binding Added}" FontSize="12" Foreground="#30D158" Margin="0,0,0,8">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Added}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button HorizontalAlignment="Left" Command="{Binding OpenAddCommand}" AutomationProperties.Name="Add task">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SmallPill}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsAdding}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <c:IconView Glyph="{StaticResource Icon.Plus}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="Add task" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- .cadd: title, an 86 px time, and the white check, 6 px apart. -->
            <Grid x:Name="AddForm" Visibility="{Binding IsAdding, Converter={StaticResource VisibleWhen}}" PreviewKeyDown="OnAddKey">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="AddTitle" Style="{StaticResource Field}" Text="{Binding AddTitle, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                         AutomationProperties.Name="New task" AutomationProperties.HelpText="Add a task for this day" />
                <TextBox Grid.Column="1" Style="{StaticResource Field}" Margin="6,0,0,0" Text="{Binding AddTime, UpdateSourceTrigger=PropertyChanged}"
                         Tag="{Binding AddTimeState}" Typography.NumeralAlignment="Tabular" MaxLength="5"
                         AutomationProperties.Name="Time" AutomationProperties.HelpText="Time"
                         ToolTip="Time (optional): a reminder card appears then" />
                <Button Grid.Column="2" Style="{StaticResource CheckPill}" Margin="6,0,0,0" Command="{Binding SaveAddCommand}"
                        AutomationProperties.Name="Add task">
                    <c:IconView Glyph="{StaticResource Icon.Check}" Width="14" Height="14" StrokeThickness="2.6" />
                </Button>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
