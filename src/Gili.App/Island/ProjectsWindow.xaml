<Window x:Class="Gili.App.Island.ProjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Gili.App.Controls"
        Title="Gili Projects" Width="1280" Height="720" MinWidth="720" MinHeight="420" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="#000000" Foreground="#F5F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <!-- The Tools frame (PRD 7.5). -->
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Minimize and maximize: the close button's size, white at 8 % on hover. -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#C7C7CC" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="46" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#14FFFFFF" BorderThickness="1">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Height="36" Background="#2B2B2B">
                <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Click="OnClose" IsTabStop="False"
                        WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close Projects">
                    <c:IconView Glyph="{StaticResource Icon.Close}" Width="14" Height="14" />
                </Button>
                <Button x:Name="MaximizeButton" DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Click="OnMaximize" AutomationProperties.Name="Maximize">
                    <c:IconView x:Name="MaximizeIcon" Glyph="{StaticResource Icon.Maximize}" Width="14" Height="14" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource CaptionButton}" Click="OnMinimize" AutomationProperties.Name="Minimize">
                    <c:IconView Glyph="{StaticResource Icon.Minimize}" Width="14" Height="14" />
                </Button>
                <c:IconView Glyph="{StaticResource Icon.Gantt}" Width="14" Height="14" Margin="12,0,8,0" Foreground="#C7C7CC" />
                <TextBlock Text="Gili Projects" FontSize="12" Foreground="#C7C7CC" VerticalAlignment="Center" />
            </DockPanel>

            <!-- The timeline runs to the window's left, right and bottom edges, as it does in the island. -->
            <ContentControl x:Name="PageHost" Margin="0,12,0,0" Focusable="False" />
        </DockPanel>
    </Border>
</Window>
