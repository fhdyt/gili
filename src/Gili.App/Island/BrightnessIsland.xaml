<UserControl x:Class="Gili.App.Island.BrightnessIsland"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Gili.App.Controls"
             AutomationProperties.Name="Brightness">
    <!-- The Brightness control island (PRD 6.4, mockup .cv[data-cv=bri]): the sun and level, then the slider. -->
    <StackPanel>
        <DockPanel MinHeight="32">
            <Border DockPanel.Dock="Left" Style="{StaticResource ControlTile}">
                <c:IconView Glyph="{StaticResource Icon.Sun}" Width="15" Height="15" />
            </Border>
            <TextBlock x:Name="Level" DockPanel.Dock="Right" FontSize="13" Foreground="#8E8E93"
                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
            <TextBlock Text="Brightness" Margin="12,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <Slider x:Name="Slider" Style="{StaticResource ControlSlider}" Margin="40,12,0,0" AutomationProperties.Name="Brightness"
                ValueChanged="OnSlide" PreviewMouseWheel="OnWheel" />
        <TextBlock x:Name="Unavailable" Text="Not available" Style="{StaticResource ControlOff}" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
