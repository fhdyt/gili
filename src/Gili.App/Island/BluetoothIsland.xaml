<UserControl x:Class="Gili.App.Island.BluetoothIsland"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Gili.App.Controls"
             AutomationProperties.Name="Bluetooth">
    <!-- The Bluetooth control island (PRD 6.4, mockup .cv[data-cv=bt]): the radio switch, then the paired devices. -->
    <StackPanel>
        <DockPanel MinHeight="32">
            <Border x:Name="Tile" DockPanel.Dock="Left" Style="{StaticResource ControlTile}">
                <c:IconView Glyph="{StaticResource Icon.Bluetooth}" Width="15" Height="15" />
            </Border>
            <ToggleButton x:Name="RadioSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                          AutomationProperties.Name="Bluetooth" Click="OnSwitch" />
            <TextBlock Text="Bluetooth" Margin="12,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <Border Style="{StaticResource ControlList}" Margin="0,12,0,0">
            <Grid>
                <ScrollViewer x:Name="ListArea" MaxHeight="228" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="Devices" ItemTemplate="{StaticResource ControlRowTemplate}" Button.Click="OnRow" />
                </ScrollViewer>
                <TextBlock x:Name="Off" Style="{StaticResource ControlOff}" Visibility="Collapsed" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
