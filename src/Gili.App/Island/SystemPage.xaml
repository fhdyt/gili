<UserControl x:Class="Gili.App.Island.SystemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- .tile: #1C1C1E, radius 12, padding 8 12, 70 px tall; the name on the left of its value. -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#1C1C1E" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Height" Value="70" />
        </Style>
        <Style x:Key="Name" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#8E8E93" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="DockPanel.Dock" Value="Right" />
        </Style>
        <!-- .sp: 26 px, a 1.6 px line with round joins; the newest second on the right edge. -->
        <Style x:Key="Chart" TargetType="Polyline">
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </UserControl.Resources>

    <!-- The whole page opens Task Manager (PRD 6.3 page 10). -->
    <Button Margin="32,0" VerticalAlignment="Center" Cursor="Hand" Command="{Binding OpenTaskManagerCommand}"
            AutomationProperties.Name="Open Task Manager" FocusVisualStyle="{StaticResource FocusRing}">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <ContentPresenter />
            </ControlTemplate>
        </Button.Template>
        <!-- .sys: three columns 8 px apart; Disk spans two. -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="8" />
                <ColumnDefinition />
                <ColumnDefinition Width="8" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Tile}" ToolTip="{Binding CpuTooltip}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding CpuText}" Style="{StaticResource Value}" />
                        <TextBlock Text="CPU" Style="{StaticResource Name}" />
                    </DockPanel>
                    <Canvas x:Name="FirstChart" Height="26" VerticalAlignment="Bottom">
                        <Polyline Points="{Binding CpuPoints}" Stroke="#0A84FF" Style="{StaticResource Chart}" />
                    </Canvas>
                </DockPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Tile}" ToolTip="{Binding RamTooltip}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding RamText}" Style="{StaticResource Value}" />
                        <TextBlock Text="RAM" Style="{StaticResource Name}" />
                    </DockPanel>
                    <Canvas Height="26" VerticalAlignment="Bottom">
                        <Polyline Points="{Binding RamPoints}" Stroke="#BF5AF2" Style="{StaticResource Chart}" />
                    </Canvas>
                </DockPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Tile}" ToolTip="{Binding GpuTooltip}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding GpuText}" Style="{StaticResource Value}" />
                        <TextBlock Text="GPU" Style="{StaticResource Name}" />
                    </DockPanel>
                    <Canvas Height="26" VerticalAlignment="Bottom">
                        <Polyline Points="{Binding GpuPoints}" Stroke="#30D158" Style="{StaticResource Chart}" />
                    </Canvas>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Tile}" ToolTip="{Binding DownTooltip}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding DownText}" Style="{StaticResource Value}" />
                        <TextBlock Text="Download" Style="{StaticResource Name}" />
                    </DockPanel>
                    <Canvas Height="26" VerticalAlignment="Bottom">
                        <Polyline Points="{Binding DownPoints}" Stroke="#64D2FF" Style="{StaticResource Chart}" />
                    </Canvas>
                </DockPanel>
            </Border>
            <!-- .dbar: 6 px, radius 3, the used share filled. -->
            <Border Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource Tile}" ToolTip="{Binding DiskTooltip}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding DiskText}" Style="{StaticResource Value}" />
                        <TextBlock Text="{Binding DiskTitle}" Style="{StaticResource Name}" />
                    </DockPanel>
                    <Border Height="6" CornerRadius="3" Background="#3A3A3C" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding DiskUsed}" />
                                <ColumnDefinition Width="{Binding DiskFree}" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="3,0,0,3" Background="#8E8E93" />
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>
    </Button>
</UserControl>
