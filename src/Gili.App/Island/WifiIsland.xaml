<UserControl x:Class="Gili.App.Island.WifiIsland"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Gili.App.Controls"
             AutomationProperties.Name="Wi‑Fi">
    <!-- The Wi‑Fi control island (PRD 6.4, mockup .cv[data-cv=wifi]): Wi‑Fi and Airplane mode switches, then the networks. -->
    <StackPanel>
        <DockPanel MinHeight="32">
            <Border x:Name="WifiTile" DockPanel.Dock="Left" Style="{StaticResource ControlTile}">
                <c:IconView Glyph="{StaticResource Icon.Wifi}" Width="15" Height="15" />
            </Border>
            <ToggleButton x:Name="WifiSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                          AutomationProperties.Name="Wi‑Fi" Checked="OnWifiSwitch" Unchecked="OnWifiSwitch" />
            <TextBlock Text="Wi‑Fi" Margin="12,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel MinHeight="32" Margin="0,4,0,0">
            <Border x:Name="AirTile" DockPanel.Dock="Left" Style="{StaticResource ControlTile}">
                <c:IconView Glyph="{StaticResource Icon.Plane}" Width="15" Height="15" />
            </Border>
            <ToggleButton x:Name="AirSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"
                          AutomationProperties.Name="Airplane mode" Checked="OnAirSwitch" Unchecked="OnAirSwitch" />
            <TextBlock Text="Airplane mode" Margin="12,0" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" />
        </DockPanel>

        <Border Style="{StaticResource ControlList}" Margin="0,12,0,0">
            <Grid>
                <ScrollViewer x:Name="ListArea" MaxHeight="228" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="Networks" ItemTemplate="{StaticResource ControlRowTemplate}" Button.Click="OnRow" />
                </ScrollViewer>
                <TextBlock x:Name="Off" Style="{StaticResource ControlOff}" Visibility="Collapsed" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
