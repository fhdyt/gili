<UserControl x:Class="Gili.App.Island.PowerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Gili.App.Controls">
    <UserControl.Resources>
        <!-- Sleep, Shut down, Restart (mockup .cv .pwl .pill): 40 px, radius 12, white 6%, 10% on hover. -->
        <Style x:Key="PowerButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Height="40" CornerRadius="12" Background="#0FFFFFFF" Padding="12,0" RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Windows Quick Settings, All settings (mockup .cv .qfoot button): 32 px, radius 10. -->
        <Style x:Key="FootButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Height="32" CornerRadius="10" Background="#0FFFFFFF" Padding="10,0">
                            <TextBlock Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- The Power control island (PRD 6.4, mockup .cv[data-cv=power]): title row, the buttons, then the Windows links. -->
    <StackPanel>
        <DockPanel MinHeight="32">
            <Border DockPanel.Dock="Left" Width="28" Height="28" CornerRadius="9" Background="#14FFFFFF" VerticalAlignment="Center">
                <c:IconView Glyph="{StaticResource Icon.Power}" Width="15" Height="15" />
            </Border>
            <TextBlock x:Name="Battery" DockPanel.Dock="Right" FontSize="13" Foreground="#8E8E93"
                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
            <TextBlock Text="Power" Margin="12,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <StackPanel Margin="0,12,0,0">
            <Button Style="{StaticResource PowerButton}" Click="OnSleep">
                <StackPanel Orientation="Horizontal">
                    <c:IconView Glyph="{StaticResource Icon.Moon}" Width="16" Height="16" Foreground="#8E8E93" />
                    <TextBlock Text="Sleep" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <!-- Only while Windows has updates waiting (F-RIGHT-08), each before its plain twin as in Start, with the orange dot. -->
            <Button x:Name="UpdateShutDown" Style="{StaticResource PowerButton}" Margin="0,4,0,0" Click="OnUpdateShutDown" Visibility="Collapsed">
                <DockPanel>
                    <Ellipse DockPanel.Dock="Right" Width="6" Height="6" Fill="#FF9F0A" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal">
                        <c:IconView Glyph="{StaticResource Icon.Power}" Width="16" Height="16" Foreground="#8E8E93" />
                        <TextBlock Text="Update and shut down" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Style="{StaticResource PowerButton}" Margin="0,4,0,0" Click="OnShutDown">
                <StackPanel Orientation="Horizontal">
                    <c:IconView Glyph="{StaticResource Icon.Power}" Width="16" Height="16" Foreground="#8E8E93" />
                    <TextBlock Text="Shut down" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button x:Name="UpdateRestart" Style="{StaticResource PowerButton}" Margin="0,4,0,0" Click="OnUpdateRestart" Visibility="Collapsed">
                <DockPanel>
                    <Ellipse DockPanel.Dock="Right" Width="6" Height="6" Fill="#FF9F0A" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal">
                        <c:IconView Glyph="{StaticResource Icon.Restart}" Width="16" Height="16" Foreground="#8E8E93" />
                        <TextBlock Text="Update and restart" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </Button>
            <Button Style="{StaticResource PowerButton}" Margin="0,4,0,0" Click="OnRestart">
                <StackPanel Orientation="Horizontal">
                    <c:IconView Glyph="{StaticResource Icon.Restart}" Width="16" Height="16" Foreground="#8E8E93" />
                    <TextBlock Text="Restart" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <Border Margin="0,12,0,0" Padding="0,12,0,0" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource FootButton}" Content="Windows Quick Settings" Click="OnQuickSettings" />
                <Button Grid.Column="2" Style="{StaticResource FootButton}" Content="All settings" Click="OnAllSettings" />
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
