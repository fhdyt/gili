<UserControl x:Class="Gili.App.Island.CardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Gili.App.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />
    </UserControl.Resources>
    <!-- A notification card (mockup .L-card, PRD 6.3 "Kartu notifikasi"): icon circle, title and line, buttons. -->
    <DockPanel Margin="24,0" VerticalAlignment="Center">
        <Grid DockPanel.Dock="Left" Width="44" Height="44">
            <Ellipse x:Name="Halo" Fill="{Binding CardTint}" />
            <!-- The pulse: a ring that grows from the circle and fades, every 1.2 s (mockup .cic.pulse). -->
            <Ellipse x:Name="PulseRing" Stroke="{Binding CardBrush}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="PulseScale" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <c:IconView Glyph="{Binding CardGlyph}" Foreground="{Binding CardBrush}" Width="22" Height="22" RenderTransformOrigin="0.5,0.5">
                <c:IconView.RenderTransform>
                    <RotateTransform x:Name="IconTurn" />
                </c:IconView.RenderTransform>
            </c:IconView>
        </Grid>
        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding CardButtons}" VerticalAlignment="Center" Margin="6,0,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Label}" Command="{Binding Command}" Margin="8,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Pill}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Primary}" Value="True">
                                        <Setter Property="Foreground" Value="#000000" />
                                        <Setter Property="Background" Value="#F5F5F7" />
                                        <Setter Property="Tag" Value="#D1D1D6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding CardTitle}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding CardSubtitle}" FontSize="13" Foreground="#8E8E93" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasCardSubtitle, Converter={StaticResource VisibleWhen}}" />
            <!-- Sound is off (mockup .cs.wrn): a yellow line with the muted speaker, 4 px below. -->
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0" Visibility="{Binding HasCardWarning, Converter={StaticResource VisibleWhen}}">
                <c:IconView Glyph="{StaticResource Icon.Volume.Mute}" Foreground="#FFD60A" Width="13" Height="13" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CardWarning}" Margin="5,0,0,0" FontSize="13" Foreground="#FFD60A" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding CardWarning}" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</UserControl>
