<UserControl x:Class="Gili.App.Bar.LeftSide"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Gili.App.Controls"
             FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#F5F5F7">
    <UserControl.Resources>
        <!-- Start and launcher buttons (mockup .start, .launch button): white 8% on hover, 14% while pressed. -->
        <Style x:Key="BarIconButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#AEAEB2" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="6" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                                <Setter Property="Foreground" Value="#F5F5F7" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- "+N": a small capsule, white 8% (16% on hover or while its list is open). -->
        <Style x:Key="MoreButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Height="22" Padding="8,0" CornerRadius="11" Background="#14FFFFFF">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#29FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ListRow" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Padding="10,7" CornerRadius="8" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3C" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Start: the Windows logo, 15 px, in a 28 × 24 button (PRD 6.2). -->
        <Button x:Name="StartButton" Style="{StaticResource BarIconButton}" Width="28" ToolTip="Start"
                AutomationProperties.Name="Start" Click="OnStart">
            <!-- Four 8.5-unit squares on a 24-unit grid, drawn as geometry so layout rounding never closes the 1-unit gaps. -->
            <Path Width="15" Height="15" Stretch="None" Fill="#4CC2FF">
                <Path.Data>
                    <GeometryGroup>
                        <GeometryGroup.Transform>
                            <ScaleTransform ScaleX="0.625" ScaleY="0.625" />
                        </GeometryGroup.Transform>
                        <RectangleGeometry Rect="3,3,8.5,8.5" RadiusX="1" RadiusY="1" />
                        <RectangleGeometry Rect="12.5,3,8.5,8.5" RadiusX="1" RadiusY="1" />
                        <RectangleGeometry Rect="3,12.5,8.5,8.5" RadiusX="1" RadiusY="1" />
                        <RectangleGeometry Rect="12.5,12.5,8.5,8.5" RadiusX="1" RadiusY="1" />
                    </GeometryGroup>
                </Path.Data>
            </Path>
        </Button>

        <!-- Launcher, Shelf and Claude: open their page in the island; the open page's icon closes it again. -->
        <StackPanel x:Name="Launcher" Orientation="Horizontal" Margin="12,0,0,0">
            <Button Style="{StaticResource BarIconButton}" Tag="Timer" ToolTip="Timer" AutomationProperties.Name="Open Timer" Click="OnLaunch">
                <c:IconView Glyph="{StaticResource Icon.Hourglass}" Width="16" Height="16" />
            </Button>
            <Button Style="{StaticResource BarIconButton}" Tag="Alarms" ToolTip="Alarms" AutomationProperties.Name="Open Alarms" Click="OnLaunch" Margin="2,0,0,0">
                <c:IconView Glyph="{StaticResource Icon.Alarm}" Width="16" Height="16" />
            </Button>
            <Button Style="{StaticResource BarIconButton}" Tag="Todo" ToolTip="Todo" AutomationProperties.Name="Open Todo" Click="OnLaunch" Margin="2,0,0,0">
                <c:IconView Glyph="{StaticResource Icon.Todo}" Width="16" Height="16" />
            </Button>
            <Button Style="{StaticResource BarIconButton}" Tag="Notes" ToolTip="Notes" AutomationProperties.Name="Open Notes" Click="OnLaunch" Margin="2,0,0,0">
                <c:IconView Glyph="{StaticResource Icon.Note}" Width="16" Height="16" />
            </Button>
            <Button Style="{StaticResource BarIconButton}" Tag="Clipboard" ToolTip="Clipboard" AutomationProperties.Name="Open Clipboard" Click="OnLaunch" Margin="2,0,0,0">
                <c:IconView Glyph="{StaticResource Icon.Clipboard}" Width="16" Height="16" />
            </Button>
            <!-- Shelf (mockup .lsh): the file count follows the tray, and the tray bounces when a drop lands. -->
            <Button x:Name="ShelfButton" Style="{StaticResource BarIconButton}" Tag="Shelf" ToolTip="Shelf" AutomationProperties.Name="Open the Shelf"
                    Click="OnLaunch" Margin="2,0,0,0" Width="NaN" MinWidth="26">
                <StackPanel Orientation="Horizontal" Margin="5,0">
                    <c:IconView x:Name="ShelfIcon" Glyph="{StaticResource Icon.Tray}" Width="16" Height="16" RenderTransformOrigin="0.5,0.5" />
                    <TextBlock x:Name="ShelfCount" Margin="4,0,0,0" Foreground="#F5F5F7" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" Visibility="Collapsed" />
                </StackPanel>
            </Button>
            <Button x:Name="ClaudeButton" Style="{StaticResource BarIconButton}" Tag="Claude" ToolTip="Claude sessions" AutomationProperties.Name="Open Claude sessions" Click="OnLaunch" Margin="2,0,0,0">
                <!-- A waiting session puts a 6 px yellow dot at the icon's top right, ringed in the bar's colour (mockup .lcl.ask). -->
                <Grid>
                    <c:IconView x:Name="ClaudeIcon" Glyph="{StaticResource Icon.Claude}" Filled="True" Width="16" Height="16" />
                    <Ellipse x:Name="ClaudeDot" Width="9" Height="9" Margin="0,-2.5,-3.5,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Fill="#FFD60A" Stroke="{DynamicResource BarRing}" StrokeThickness="1.5" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="ClaudeDotScale" ScaleX="0" ScaleY="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
            </Button>
            <!-- Favorite apps (F-LEFT-08): their own icons after Claude, before the divider; filled by LeftSide.ShowFavorites. -->
            <StackPanel x:Name="FavoritesRow" Tag="Favorites" Orientation="Horizontal" />
        </StackPanel>

        <Border x:Name="Rule" Width="1" Height="14" Background="#38FFFFFF" Margin="12,0,0,0" />

        <StackPanel x:Name="Strip" Orientation="Horizontal" Margin="12,0,0,0" Background="Transparent"
                    MouseMove="OnStripMouseMove" MouseLeave="OnStripMouseLeave" />
        <Button x:Name="More" Style="{StaticResource MoreButton}" Margin="2,0,0,0" Visibility="Collapsed" Click="OnMore"
                AutomationProperties.Name="More open apps" Typography.NumeralAlignment="Tabular" />
        <Popup x:Name="MoreList" PlacementTarget="{Binding ElementName=More}" Placement="Bottom" VerticalOffset="6"
               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
            <Border Margin="12,0,12,24" MinWidth="210" Padding="4" CornerRadius="12" Background="#1C1C1E"
                    BorderBrush="#12FFFFFF" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="16" Direction="270" Opacity="0.75" Color="Black" />
                </Border.Effect>
                <StackPanel x:Name="MoreItems" />
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
