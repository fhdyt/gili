<Window x:Class="Gili.App.Bar.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Gili.App.Controls"
        Title="Gili" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        Left="0" Top="0" Width="800" Height="32" UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" Foreground="#F5F5F7"
        AllowDrop="True" DragEnter="OnFileDrag" DragOver="OnFileDrag" DragLeave="OnFileDragLeave" Drop="OnFileDrop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />
        <Style x:Key="BarMenu" TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#1C1C1E" CornerRadius="12" Padding="4" BorderBrush="#12FFFFFF" BorderThickness="1">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarMenuItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#F5F5F7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bg" MinWidth="180" Padding="10,7" CornerRadius="8" Background="Transparent">
                            <DockPanel>
                                <c:IconView x:Name="Check" DockPanel.Dock="Right" Glyph="{StaticResource Icon.Check}" Width="14" Height="14"
                                            Margin="12,0,0,0" Visibility="Collapsed" />
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3C" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BarMenuSeparator" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="6,4" Background="#14FFFFFF" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Right-hand modules, two-line style (PRD 6.4). Padding plus margin leaves 10 px between modules. -->
        <Style x:Key="Module" TargetType="Border">
            <Setter Property="Height" Value="{Binding ModuleHeight}" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style x:Key="ClickableModule" TargetType="Border" BasedOn="{StaticResource Module}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#14FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TwoLine" TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="28" />
        </Style>
        <Style x:Key="ModuleLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="8.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9A9AA0" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="9.2" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>
        <Style x:Key="ModuleValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="12.4" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
        <Style x:Key="NetLine" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="Foreground" Value="#D1D1D6" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="LineHeight" Value="11.4" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        </Style>
    </Window.Resources>

    <!-- Nearly clear rather than empty, so a file dragged over the bar is still seen once the backdrop fades for the drop zone. -->
    <Grid Background="#01000000">
        <Grid.ContextMenu>
            <ContextMenu x:Name="BarMenu" Style="{StaticResource BarMenu}">
                <MenuItem Header="Open Tools" Style="{StaticResource BarMenuItem}" Click="OnTools" />
                <MenuItem Header="Settings" Style="{StaticResource BarMenuItem}" Click="OnSettings" />
                <MenuItem x:Name="DemoItem" Header="Demo mode" Style="{StaticResource BarMenuItem}" Click="OnDemo" />
                <Separator Style="{StaticResource BarMenuSeparator}" />
                <MenuItem Header="Quit" Style="{StaticResource BarMenuItem}" Click="OnQuit" />
            </ContextMenu>
        </Grid.ContextMenu>
        <!-- The backdrop fades on its own while the island floats; the content above it stays (PRD 6.3). -->
        <Border x:Name="Backdrop" Background="{Binding Tint}" BorderBrush="#0FFFFFFF" BorderThickness="0,0,0,1" />
        <Grid x:Name="BarContent" Margin="10,0">
            <Grid.ColumnDefinitions>
                <!-- Equal star columns keep the middle centred on the screen, under the island in IslandWindow. -->
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ContentControl x:Name="LeftSlot" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Focusable="False" />

            <StackPanel x:Name="RightModules" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- Weather: icon, then the short condition over the temperature; grey while the reading is stale. -->
                <!-- Visibility comes from FitRight: no reading yet, or no room beside the island, hides it. -->
                <Border x:Name="WeatherModule" Tag="weather" Style="{StaticResource Module}" ToolTip="{Binding WeatherTooltip}" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Opacity="{Binding WeatherOpacity}">
                        <c:IconView Glyph="{Binding WeatherGlyph}" Width="16" Height="16" Foreground="#AEAEB2" VerticalAlignment="Center" />
                        <StackPanel Style="{StaticResource TwoLine}" Margin="6,0,0,0">
                            <TextBlock Text="{Binding WeatherLabel}" Style="{StaticResource ModuleLabel}" />
                            <TextBlock Text="{Binding WeatherValue}" Style="{StaticResource ModuleValue}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Tag="net" Style="{StaticResource Module}" ToolTip="{Binding NetTooltip}">
                    <StackPanel VerticalAlignment="Center" MinWidth="58">
                        <TextBlock Text="{Binding UpText}" Style="{StaticResource NetLine}" />
                        <TextBlock Text="{Binding DownText}" Style="{StaticResource NetLine}" />
                    </StackPanel>
                </Border>
                <!-- Network through Disk follow the order set in Settings → Right side; FitRight shows what is switched on. -->
                <Border Tag="cpu" Style="{StaticResource ClickableModule}" ToolTip="{Binding CpuTooltip}" MouseLeftButtonUp="OnSystem">
                    <StackPanel Style="{StaticResource TwoLine}">
                        <TextBlock Text="CPU" Style="{StaticResource ModuleLabel}" />
                        <TextBlock Text="{Binding CpuText}" Style="{StaticResource ModuleValue}" />
                    </StackPanel>
                </Border>
                <Border Tag="ram" Style="{StaticResource ClickableModule}" ToolTip="{Binding RamTooltip}" MouseLeftButtonUp="OnSystem">
                    <StackPanel Style="{StaticResource TwoLine}">
                        <TextBlock Text="RAM" Style="{StaticResource ModuleLabel}" />
                        <TextBlock Text="{Binding RamText}" Style="{StaticResource ModuleValue}" />
                    </StackPanel>
                </Border>
                <!-- GPU and free disk space start switched off (F-RIGHT-03). -->
                <Border Tag="gpu" Style="{StaticResource ClickableModule}" ToolTip="{Binding GpuTooltip}" MouseLeftButtonUp="OnSystem" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource TwoLine}">
                        <TextBlock Text="GPU" Style="{StaticResource ModuleLabel}" />
                        <TextBlock Text="{Binding GpuText}" Style="{StaticResource ModuleValue}" />
                    </StackPanel>
                </Border>
                <Border Tag="disk" Style="{StaticResource ClickableModule}" ToolTip="{Binding DiskTooltip}" MouseLeftButtonUp="OnSystem" Visibility="Collapsed">
                    <StackPanel Style="{StaticResource TwoLine}">
                        <TextBlock Text="{Binding DiskLabel}" Style="{StaticResource ModuleLabel}" />
                        <TextBlock Text="{Binding DiskText}" Style="{StaticResource ModuleValue}" />
                    </StackPanel>
                </Border>
                <!-- Modules that don't fit beside the island move here (PRD 6.4). -->
                <Border x:Name="MoreModule" Style="{StaticResource ClickableModule}" Visibility="Collapsed" MouseLeftButtonUp="OnMoreModules"
                        AutomationProperties.Name="More modules">
                    <c:IconView Glyph="{StaticResource Icon.Dots}" Filled="True" Width="16" Height="16" />
                </Border>
                <Popup x:Name="MoreModulesList" PlacementTarget="{Binding ElementName=MoreModule}" Placement="Bottom" VerticalOffset="6"
                       AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                    <Border Margin="12,0,12,24" MinWidth="180" Padding="10,8" CornerRadius="12" Background="#1C1C1E" BorderBrush="#12FFFFFF" BorderThickness="1"
                            TextElement.FontSize="13">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="32" ShadowDepth="16" Direction="270" Opacity="0.75" Color="Black" />
                        </Border.Effect>
                        <StackPanel x:Name="MoreModulesItems" />
                    </Border>
                </Popup>
                <Border Tag="wifi" Style="{StaticResource ClickableModule}" ToolTip="{Binding WifiTooltip}" MouseLeftButtonUp="OnWifi"
                        AutomationProperties.Name="Wi‑Fi">
                    <StackPanel Orientation="Horizontal">
                        <c:IconView Glyph="{StaticResource Icon.Wifi}" Width="16" Height="16" VerticalAlignment="Center" />
                        <StackPanel Style="{StaticResource TwoLine}" Margin="6,0,0,0" Visibility="{Binding WifiHasText, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{Binding WifiLabel}" Style="{StaticResource ModuleLabel}" />
                            <TextBlock Text="{Binding WifiValue}" Style="{StaticResource ModuleValue}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Bluetooth: a small blue dot in the corner while a device is connected. -->
                <Border Tag="bt" Style="{StaticResource ClickableModule}" ToolTip="{Binding BluetoothTooltip}" MouseLeftButtonUp="OnBluetooth"
                        AutomationProperties.Name="Bluetooth">
                    <Grid>
                        <c:IconView Glyph="{StaticResource Icon.Bluetooth}" Width="16" Height="16" />
                        <Ellipse Width="9" Height="9" Fill="#0A84FF" Stroke="#161618" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,1.5,-3.5,0" Visibility="{Binding BluetoothConnected, Converter={StaticResource VisibleWhen}}" />
                    </Grid>
                </Border>
                <Border Tag="vol" Style="{StaticResource ClickableModule}" ToolTip="{Binding VolumeTooltip}" MouseLeftButtonUp="OnVolume"
                        AutomationProperties.Name="Volume">
                    <c:IconView Glyph="{Binding VolumeGlyph}" Width="16" Height="16" />
                </Border>
                <Border Tag="bri" Style="{StaticResource ClickableModule}" ToolTip="{Binding BrightnessTooltip}" MouseLeftButtonUp="OnBrightness"
                        ToolTipOpening="OnBrightnessTooltip" AutomationProperties.Name="Brightness">
                    <c:IconView Glyph="{StaticResource Icon.Sun}" Width="16" Height="16" />
                </Border>
                <Border Tag="tray" Style="{StaticResource ClickableModule}" ToolTip="Show hidden icons" MouseLeftButtonUp="OnHiddenIcons"
                        AutomationProperties.Name="Show hidden icons">
                    <c:IconView x:Name="TrayChevron" Glyph="{StaticResource Icon.ChevronDown}" Width="14" Height="14" RenderTransformOrigin="0.5,0.5" />
                </Border>
                <!-- Clock: the date is the small label, the time the value (PRD 6.4). Click opens Calendar. -->
                <Border Tag="clock" Style="{StaticResource ClickableModule}" ToolTip="{Binding ClockTooltip}" MouseLeftButtonUp="OnClock">
                    <StackPanel Style="{StaticResource TwoLine}" MinWidth="46">
                        <TextBlock Text="{Binding ClockDate}" Style="{StaticResource ModuleLabel}" />
                        <Grid HorizontalAlignment="Left">
                            <TextBlock Text="{Binding ClockTemplate}" Style="{StaticResource ModuleValue}" Visibility="Hidden" />
                            <TextBlock Text="{Binding ClockTime}" Style="{StaticResource ModuleValue}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- Settings: a small blue dot in the corner while a newer Gili waits (PRD 9.4, design 5d). -->
                <Border Style="{StaticResource ClickableModule}" ToolTip="{Binding SettingsTooltip}" MouseLeftButtonUp="OnSettingsButton" AutomationProperties.Name="Settings">
                    <Grid>
                        <c:IconView Glyph="{StaticResource Icon.Gear}" Width="16" Height="16" />
                        <Ellipse Width="9" Height="9" Fill="#0A84FF" Stroke="#161618" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,1.5,-3.5,0" Visibility="{Binding GiliUpdate, Converter={StaticResource VisibleWhen}}" />
                    </Grid>
                </Border>
                <!-- Power: a small orange dot in the corner while Windows has updates waiting (F-RIGHT-08, mockup .udot). -->
                <Border Style="{StaticResource ClickableModule}" ToolTip="{Binding PowerTooltip}" MouseLeftButtonUp="OnPower" AutomationProperties.Name="Power">
                    <Grid>
                        <c:IconView Glyph="{StaticResource Icon.Power}" Width="16" Height="16" />
                        <Ellipse Width="9" Height="9" Fill="#FF9F0A" Stroke="#161618" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,1.5,-3.5,0" Visibility="{Binding UpdatesPending, Converter={StaticResource VisibleWhen}}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
