<UserControl x:Class="Gili.App.Tools.TimersTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="VisibleWhen" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- The editor (mockup .aedit.lg): names in a 76 px column, 10 px between lines. -->
        <Border DataContext="{Binding Editor}" Background="#0AFFFFFF" CornerRadius="8" Padding="16,12" Margin="0,0,0,12"
                Visibility="{Binding DataContext.HasEditor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}}"
                AutomationProperties.Name="{Binding Title}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Label" Foreground="#8E8E93" VerticalAlignment="Center" />
                <TextBox x:Name="LabelBox" Grid.Column="1" Style="{StaticResource TextField}" Width="240" HorizontalAlignment="Left"
                         Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                         AutomationProperties.Name="Label" AutomationProperties.HelpText="Timer" />

                <TextBlock Grid.Row="1" Text="Duration" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,10,0,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource TextField}" Width="80" HorizontalAlignment="Left" Margin="0,10,0,0"
                         Text="{Binding DurationText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding IsDurationInvalid}"
                         Typography.NumeralAlignment="Tabular" AutomationProperties.Name="Duration" AutomationProperties.HelpText="5:00" />

                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Style="{StaticResource ToolButton}" Content="Cancel" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource PrimaryToolButton}" Content="Save" Margin="8,0,0,0" Command="{Binding SaveCommand}" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="No timers yet" Foreground="#8E8E93" Margin="0,4,0,0"
                   Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" />

        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemContainerStyle>
                <!-- Each row reads by its name, not by its view model's type. -->
                <Style TargetType="ContentPresenter">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- One timer (mockup .srow): time 17 px in 76 px, label and state · length, Start, Reset, Edit, Delete; 12 px apart. -->
                    <Border MinHeight="46" Padding="12,6" Margin="0,0,0,4" CornerRadius="8" Background="#0AFFFFFF">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Width="76" Margin="0,0,12,0" Text="{Binding Time}" FontSize="17" FontWeight="SemiBold"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ToolButton}" Content="{Binding ButtonText}" Margin="12,0,0,0" Command="{Binding StartCommand}"
                                        AutomationProperties.Name="{Binding Label, StringFormat='Start or pause {0}'}" />
                                <Button Style="{StaticResource ToolButton}" Content="Reset" Margin="12,0,0,0" Command="{Binding ResetCommand}"
                                        AutomationProperties.Name="{Binding Label, StringFormat='Reset {0}'}" />
                                <Button Style="{StaticResource ToolButton}" Content="Edit" Margin="12,0,0,0" Command="{Binding EditCommand}"
                                        AutomationProperties.Name="{Binding Label, StringFormat='Edit {0}'}" />
                                <Button Style="{StaticResource DangerToolButton}" Content="{Binding Delete.Text}" Margin="12,0,0,0" Command="{Binding Delete.Command}"
                                        AutomationProperties.Name="{Binding Label, StringFormat='Delete {0}'}" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="#8E8E93" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                                           Typography.NumeralAlignment="Tabular" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
