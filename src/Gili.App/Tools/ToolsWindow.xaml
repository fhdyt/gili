<Window x:Class="Gili.App.Tools.ToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Gili.App.Controls"
        xmlns:local="clr-namespace:Gili.App.Tools"
        Title="Gili Tools" Width="720" Height="520" MinWidth="560" MinHeight="420" WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="#202020" Foreground="#F5F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <!-- As Settings, but its edges resize the window (PRD 7.5). -->
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/WindowControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhen" />

            <Style x:Key="FieldName" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#8E8E93" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#14FFFFFF" BorderThickness="1">
        <DockPanel>
            <!-- Title bar (mockup .stb). -->
            <DockPanel DockPanel.Dock="Top" Height="36" Background="#2B2B2B">
                <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Click="OnClose" IsTabStop="False"
                        WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close Tools">
                    <c:IconView Glyph="{StaticResource Icon.Close}" Width="14" Height="14" />
                </Button>
                <c:IconView Glyph="{StaticResource Icon.Sliders}" Width="14" Height="14" Margin="12,0,8,0" Foreground="#C7C7CC" />
                <TextBlock Text="Gili Tools" FontSize="12" Foreground="#C7C7CC" VerticalAlignment="Center" />
            </DockPanel>

            <Border DockPanel.Dock="Left" Width="150" BorderBrush="#0FFFFFFF" BorderThickness="0,0,1,0">
                <ListBox x:Name="Nav" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}"
                         ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0" Padding="8"
                         AutomationProperties.Name="Tools sections">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter Margin="{TemplateBinding Padding}" />
                        </ControlTemplate>
                    </ListBox.Template>
                </ListBox>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Padding="20,16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="New alarm" Command="{Binding Alarms.NewCommand}"
                                Visibility="{Binding IsAlarms, Converter={StaticResource VisibleWhen}}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="New timer" Command="{Binding Timers.NewCommand}"
                                Visibility="{Binding IsTimer, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock Text="{Binding SelectedTab}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <TextBlock Text="Coming in a later version" Foreground="#8E8E93">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsComingLater}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <local:TimersTab DataContext="{Binding Timers}"
                                     Visibility="{Binding DataContext.IsTimer, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />
                    <local:StopwatchTab DataContext="{Binding Stopwatch}"
                                        Visibility="{Binding DataContext.IsStopwatch, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />
                    <local:PomodoroTab DataContext="{Binding Pomodoro}"
                                       Visibility="{Binding DataContext.IsPomodoro, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhen}}" />

                    <StackPanel DataContext="{Binding Alarms}" Visibility="{Binding DataContext.IsAlarms, RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource VisibleWhen}}">
                        <!-- The editor (mockup .aedit): names in a 64 px column, 10 px between lines. -->
                        <Border DataContext="{Binding Editor}" Background="#0AFFFFFF" CornerRadius="8" Padding="16,12" Margin="0,0,0,12"
                                Visibility="{Binding DataContext.Alarms.HasEditor, RelativeSource={RelativeSource AncestorType=Window},
                                Converter={StaticResource VisibleWhen}}"
                                AutomationProperties.Name="{Binding Title}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="76" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource FieldName}" Text="Time" />
                                <TextBox x:Name="TimeBox" Grid.Column="1" Style="{StaticResource TextField}" Width="80" HorizontalAlignment="Left"
                                         Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding IsTimeInvalid}"
                                         Typography.NumeralAlignment="Tabular" AutomationProperties.Name="Time" AutomationProperties.HelpText="07:00" />

                                <TextBlock Grid.Row="1" Style="{StaticResource FieldName}" Text="Label" Margin="0,10,0,0" />
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource TextField}" Width="240" HorizontalAlignment="Left" Margin="0,10,0,0"
                                         Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                         AutomationProperties.Name="Label" AutomationProperties.HelpText="Alarm" />

                                <TextBlock Grid.Row="2" Style="{StaticResource FieldName}" Text="Repeat" Margin="0,10,0,0" />
                                <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                                    <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding QuickChoices}" SelectedItem="{Binding QuickRepeat}"
                                             Margin="0,0,8,0" VerticalAlignment="Center" AutomationProperties.Name="Repeat" />
                                    <ItemsControl ItemsSource="{Binding Days}" Focusable="False" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource DayToggle}" Content="{Binding Name}" IsChecked="{Binding IsOn}"
                                                              Margin="0,0,4,0" AutomationProperties.Name="{Binding FullName}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </WrapPanel>

                                <TextBlock Grid.Row="3" Style="{StaticResource FieldName}" Text="Sound" Margin="0,10,0,0" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding Sounds}" SelectedItem="{Binding Sound}"
                                             VerticalAlignment="Center" AutomationProperties.Name="Sound" />
                                    <Button Style="{StaticResource ToolButton}" Padding="0" Width="30" Margin="8,0,0,0" Command="{Binding PlayCommand}"
                                            AutomationProperties.Name="{Binding Sound, StringFormat='Play {0}'}">
                                        <c:IconView Glyph="{StaticResource Icon.Play}" Filled="True" Width="12" Height="12" />
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Style="{StaticResource ToolButton}" Content="Cancel" Command="{Binding CancelCommand}" />
                                    <Button Style="{StaticResource PrimaryToolButton}" Content="Save" Margin="8,0,0,0" Command="{Binding SaveCommand}"
                                            IsDefault="True" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="No alarms yet" Foreground="#8E8E93" Margin="0,4,0,0"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" />

                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- One alarm (mockup .srow): time 17 px, label and days · sound, Edit, Delete, switch; 12 px apart. -->
                                    <Border MinHeight="46" Padding="12,6" Margin="0,0,0,4" CornerRadius="8" Background="#0AFFFFFF">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Width="52" Margin="0,0,12,0" Text="{Binding Time}" FontSize="17" FontWeight="SemiBold"
                                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource ToolButton}" Content="Edit" Margin="12,0,0,0" Command="{Binding EditCommand}"
                                                        AutomationProperties.Name="{Binding Time, StringFormat='Edit alarm {0}'}" />
                                                <Button Style="{StaticResource DangerToolButton}" Content="{Binding DeleteText}" Margin="12,0,0,0"
                                                        Command="{Binding DeleteCommand}" AutomationProperties.Name="{Binding Time, StringFormat='Delete alarm {0}'}" />
                                                <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsOn}" Margin="12,0,0,0"
                                                              AutomationProperties.Name="{Binding Time, StringFormat='Alarm {0}'}" />
                                            </StackPanel>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="#8E8E93" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
