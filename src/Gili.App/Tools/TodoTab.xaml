<UserControl x:Class="Gili.App.Tools.TodoTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="VisibleWhen" />

            <!-- One task (mockup .srow.td): tinted, grey and crossed out when done; lifted while dragged; a faint wash when focused. -->
            <Style x:Key="TaskRow" TargetType="Border">
                <Setter Property="Background" Value="#0AFFFFFF" />
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter Property="Background" Value="#14FFFFFF" />
                    </Trigger>
                    <DataTrigger Binding="{Binding IsLifted}" Value="True">
                        <Setter Property="Background" Value="#2C2C2E" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TaskTitle" TargetType="TextBlock">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                        <Setter Property="Foreground" Value="#636366" />
                        <Setter Property="TextDecorations" Value="Strikethrough" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="TaskDue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="#8E8E93" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="12,0,0,0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                        <Setter Property="Foreground" Value="#FF453A" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <!-- The filter and the note on where tasks come from (mockup .tdhead). No add: tasks are made from Calendar in the island. -->
        <DockPanel Margin="0,0,0,12">
            <ListBox DockPanel.Dock="Left" Style="{StaticResource Segments}" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}"
                     VerticalAlignment="Center" AutomationProperties.Name="Show" />
            <TextBlock Text="{Binding Note}" FontSize="12" Foreground="#8E8E93" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- The editor (mockup .aedit.lg): names in a 76 px column, 10 px between lines. -->
        <Border DataContext="{Binding Editor}" Background="#0AFFFFFF" CornerRadius="8" Padding="16,12" Margin="0,0,0,12"
                Visibility="{Binding DataContext.HasEditor, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibleWhen}}"
                AutomationProperties.Name="{Binding Title}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Title" Foreground="#8E8E93" VerticalAlignment="Center" />
                <TextBox x:Name="TitleBox" Grid.Column="1" Style="{StaticResource TextField}" Width="240" HorizontalAlignment="Left"
                         Text="{Binding TitleText, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                         AutomationProperties.Name="Title" />

                <TextBlock Grid.Row="1" Text="Date" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,10,0,0" />
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource TextField}" Width="140" HorizontalAlignment="Left" Margin="0,10,0,0"
                         Text="{Binding DateText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding IsDateInvalid}"
                         AutomationProperties.Name="Date" AutomationProperties.HelpText="No date" />

                <TextBlock Grid.Row="2" Text="Time" Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,10,0,0" />
                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource TextField}" Width="80" HorizontalAlignment="Left" Margin="0,10,0,0"
                         Text="{Binding TimeText, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding TimeEdge}"
                         Typography.NumeralAlignment="Tabular" AutomationProperties.Name="Time" AutomationProperties.HelpText="No time" />

                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Style="{StaticResource ToolButton}" Content="Cancel" Command="{Binding CancelCommand}" />
                    <Button Style="{StaticResource PrimaryToolButton}" Content="Save" Margin="8,0,0,0" Command="{Binding SaveCommand}" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="{Binding EmptyText}" Foreground="#8E8E93" Margin="0,4,0,0"
                   Visibility="{Binding IsEmpty, Converter={StaticResource VisibleWhen}}" />

        <ItemsControl x:Name="List" ItemsSource="{Binding Rows}" Focusable="False">
            <ItemsControl.ItemContainerStyle>
                <!-- Each row reads by its name, not by its view model's type. -->
                <Style TargetType="ContentPresenter">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- One task (mockup .srow.td): check, title, when it is due, Edit, Delete; 12 px apart. -->
                    <Border Style="{StaticResource TaskRow}" MinHeight="46" Padding="12,6" Margin="0,0,0,4" CornerRadius="8"
                            Focusable="True" FocusVisualStyle="{x:Null}">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Left" Style="{StaticResource CheckCircle}" IsChecked="{Binding IsDone}" Margin="0,0,12,0"
                                          VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TaskDue}" Text="{Binding Due}" ToolTip="{Binding DueTip}" Typography.NumeralAlignment="Tabular" />
                                <Button Style="{StaticResource ToolButton}" Content="Edit" Margin="12,0,0,0" Command="{Binding EditCommand}"
                                        AutomationProperties.Name="{Binding Title, StringFormat='Edit {0}'}" />
                                <Button Style="{StaticResource DangerToolButton}" Content="{Binding Delete.Text}" Margin="12,0,0,0" Command="{Binding Delete.Command}"
                                        AutomationProperties.Name="{Binding Title, StringFormat='Delete {0}'}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource TaskTitle}" Text="{Binding Title}" ToolTip="{Binding Title}" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
