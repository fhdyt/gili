<Window x:Class="Gili.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Gili.App.Controls"
        Title="Gili Settings" Width="640" Height="460" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#202020" Foreground="#F5F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <!-- A thin frame edge keeps the DWM shadow; the corners are rounded by DWM (8 px). -->
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhen" />

        <!-- Shown only when moving with the keyboard, like the mockup's :focus-visible outline (2 px blue). -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3" CornerRadius="9" BorderBrush="#0A84FF" BorderThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#C7C7CC" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="46" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section list (mockup .setn button). -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#8E8E93" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" CornerRadius="6" Padding="10,7" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0FFFFFFF" />
                                <Setter Property="Foreground" Value="#F5F5F7" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#17FFFFFF" />
                                <Setter Property="Foreground" Value="#F5F5F7" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Switch (mockup .sw): 38 × 22, knob 18 px sliding 16 px on the pop curve. -->
        <Style x:Key="Switch" TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Width="38" Height="22">
                            <Border x:Name="Track" CornerRadius="11" Background="#48484A" />
                            <Ellipse Width="18" Height="18" Fill="#FFFFFF" HorizontalAlignment="Left" Margin="2,0,0,0">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="2" Direction="270" Opacity="0.3" />
                                </Ellipse.Effect>
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="Knob" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="X" To="16" Duration="0:0:0.26"
                                                             EasingFunction="{x:Static c:BezierEase.Pop}" />
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Background.Color" To="#30D158" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.26"
                                                             EasingFunction="{x:Static c:BezierEase.Pop}" />
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="Background.Color" To="#48484A" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented choice (mockup .seg). -->
        <Style x:Key="Segments" TargetType="ListBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="#1C1C1E" CornerRadius="9" Padding="2">
                            <ItemsPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="OverridesDefaultStyle" Value="True" />
                        <Setter Property="Foreground" Value="#8E8E93" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bg" CornerRadius="7" Padding="10,4" Background="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#3A3A3C" />
                                            <Setter Property="Foreground" Value="#F5F5F7" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Range (mockup input[type=range] with the green accent): 4 px track, 16 px thumb. -->
        <Style x:Key="TrackPart" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Range" TargetType="Slider">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Width" Value="150" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track" Height="16">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackPart}" Background="#30D158" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackPart}" Background="#48484A" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Width="16" Height="16" Fill="#30D158" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin dark scroll bar (mockup scrollbar-width:thin, #48484A on transparent). -->
        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="6" CornerRadius="3" Background="#48484A" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RowTemplate">
            <!-- One row (mockup .srow): label and note on the left, its control on the right. -->
            <Border x:Name="Row" MinHeight="46" Padding="12,6" Margin="0,0,0,4" CornerRadius="8" Background="#0AFFFFFF"
                    IsEnabled="{Binding IsEnabled}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Label}"
                                      Visibility="{Binding IsSwitch, Converter={StaticResource VisibleWhen}}" />
                        <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding Options}" SelectedItem="{Binding Choice}"
                                 AutomationProperties.Name="{Binding Label}" Visibility="{Binding IsSegment, Converter={StaticResource VisibleWhen}}" />
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsRange, Converter={StaticResource VisibleWhen}}">
                            <Slider Style="{StaticResource Range}" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value}"
                                    AutomationProperties.Name="{Binding Label}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ValueText}" Width="38" Margin="12,0,0,0" TextAlignment="Right"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Note}" FontSize="11.5" Foreground="#8E8E93" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasNote, Converter={StaticResource VisibleWhen}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsEnabled" Value="False">
                    <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border BorderBrush="#14FFFFFF" BorderThickness="1">
        <DockPanel>
            <!-- Title bar (mockup .stb): drawn by Gili, dragged through WindowChrome's caption. -->
            <DockPanel DockPanel.Dock="Top" Height="36" Background="#2B2B2B">
                <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Click="OnClose" IsTabStop="False"
                        WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close Settings">
                    <c:IconView Glyph="{StaticResource Icon.Close}" Width="14" Height="14" />
                </Button>
                <c:IconView Glyph="{StaticResource Icon.Gear}" Width="14" Height="14" Margin="12,0,8,0" Foreground="#C7C7CC" />
                <TextBlock Text="Gili Settings" FontSize="12" Foreground="#C7C7CC" VerticalAlignment="Center" />
            </DockPanel>

            <Border DockPanel.Dock="Left" Width="150" BorderBrush="#0FFFFFFF" BorderThickness="0,0,1,0">
                <ListBox x:Name="Nav" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" DisplayMemberPath="Name"
                         ItemContainerStyle="{StaticResource NavItem}" Background="Transparent" BorderThickness="0" Padding="8"
                         AutomationProperties.Name="Settings sections">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter Margin="{TemplateBinding Padding}" />
                        </ControlTemplate>
                    </ListBox.Template>
                </ListBox>
            </Border>

            <ScrollViewer x:Name="Page" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedSection.Name}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
