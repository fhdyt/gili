<Window x:Class="Gili.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Gili.App.Controls"
        Title="Gili Settings" Width="640" Height="460" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#202020" Foreground="#F5F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <!-- A thin frame edge keeps the DWM shadow; the corners are rounded by DWM (8 px). -->
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="VisibleWhen" />
            <c:VisibleWhenFalse x:Key="VisibleWhenFalse" />

            <!-- Range (mockup input[type=range] with the green accent): 4 px track, 16 px thumb. -->
            <Style x:Key="TrackPart" TargetType="RepeatButton">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RepeatButton">
                            <Grid Background="Transparent">
                                <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Range" TargetType="Slider">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Width" Value="150" />
                <Setter Property="IsSnapToTickEnabled" Value="True" />
                <Setter Property="TickFrequency" Value="1" />
                <Setter Property="SmallChange" Value="1" />
                <Setter Property="LargeChange" Value="5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Slider">
                            <Track x:Name="PART_Track" Height="16">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackPart}" Background="#30D158" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource TrackPart}" Background="#48484A" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="#30D158" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A key cap: #2C2C2E, radius 8, tabular 13 px; outlined in the accent while it records. -->
            <Style x:Key="ShortcutButton" TargetType="Button">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
                <Setter Property="Foreground" Value="#F5F5F7" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg" MinWidth="120" Height="30" CornerRadius="8" Padding="12,0" Background="#2C2C2E"
                                    BorderBrush="Transparent" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#3A3A3C" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                    <Setter TargetName="Bg" Property="BorderBrush" Value="#30D158" />
                                    <Setter Property="Foreground" Value="#8E8E93" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="RowTemplate">
                <!-- One row (mockup .srow): label and note on the left, its control on the right. -->
                <Border x:Name="Row" MinHeight="46" Padding="12,6" Margin="0,0,0,4" CornerRadius="8" Background="#0AFFFFFF"
                        IsEnabled="{Binding IsEnabled}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding Label}"
                                          AutomationProperties.HelpText="{Binding ReorderHelp}"
                                          Visibility="{Binding IsSwitch, Converter={StaticResource VisibleWhen}}" />
                            <ListBox Style="{StaticResource Segments}" ItemsSource="{Binding Options}" SelectedItem="{Binding Choice}"
                                     AutomationProperties.Name="{Binding Label}" Visibility="{Binding IsSegment, Converter={StaticResource VisibleWhen}}" />
                            <!-- A Shortcuts row: the combination as a key cap; click, then press the new keys (Esc keeps the old). -->
                            <Button Style="{StaticResource ShortcutButton}" Content="{Binding ShortcutText}" Click="OnShortcutClick"
                                    LostKeyboardFocus="OnShortcutLostFocus" AutomationProperties.Name="{Binding Label}"
                                    AutomationProperties.HelpText="Press to record a new shortcut"
                                    Visibility="{Binding IsShortcut, Converter={StaticResource VisibleWhen}}" />
                            <!-- Weather city: the chosen city; click to search by name (design 4c). -->
                            <Grid Visibility="{Binding IsCity, Converter={StaticResource VisibleWhen}}">
                                <Button Style="{StaticResource ShortcutButton}" Content="{Binding City}" Click="OnCityClick"
                                        AutomationProperties.Name="{Binding Label}" AutomationProperties.HelpText="Press to search for another city"
                                        Visibility="{Binding IsSearchingCity, Converter={StaticResource VisibleWhenFalse}}" />
                                <TextBox Style="{StaticResource Field}" Width="220" Text="{Binding CityQuery, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Search city" AutomationProperties.HelpText="Search city"
                                         IsVisibleChanged="OnCityFieldShown" PreviewKeyDown="OnCityKey"
                                         Visibility="{Binding IsSearchingCity, Converter={StaticResource VisibleWhen}}" />
                            </Grid>
                            <!-- About: the version as text, and buttons in the key cap's style (design 5a). -->
                            <TextBlock Text="{Binding InfoText}" Foreground="#C7C7CC" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"
                                       Visibility="{Binding ShowInfo, Converter={StaticResource VisibleWhen}}" />
                            <Button Style="{StaticResource ShortcutButton}" Content="{Binding ButtonText}" Command="{Binding RunCommand}"
                                    AutomationProperties.Name="{Binding Label}"
                                    Visibility="{Binding ShowButton, Converter={StaticResource VisibleWhen}}" />
                            <!-- Bar color (F-BAR-14): eight 20 px circles and Custom, the chosen one ringed in white (mockup .swc). -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsColor, Converter={StaticResource VisibleWhen}}">
                                <ItemsControl ItemsSource="{Binding Swatches}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding PickCommand}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                                    FocusVisualStyle="{StaticResource FocusRing}" Cursor="Hand" Margin="0,0,4,0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Ring" Width="26" Height="26" CornerRadius="13" BorderThickness="2" BorderBrush="Transparent" Padding="1">
                                                            <Ellipse Fill="{Binding Brush}" Stroke="#33FFFFFF" StrokeThickness="1" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter TargetName="Ring" Property="BorderBrush" Value="#F5F5F7" />
                                                            </DataTrigger>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Ring" Property="Opacity" Value="0.85" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Custom: a dashed circle with #, filled with the custom colour once one is in use. -->
                                <Button Click="OnCustomColor" ToolTip="Custom" AutomationProperties.Name="Custom color" FocusVisualStyle="{StaticResource FocusRing}" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Ring" Width="26" Height="26" CornerRadius="13" BorderThickness="2" BorderBrush="Transparent" Padding="1">
                                                <Grid>
                                                    <Ellipse Fill="{Binding CustomBrush}" Stroke="#8E8E93" StrokeThickness="1" StrokeDashArray="2 2" />
                                                    <TextBlock Text="#" FontSize="11" Foreground="#C7C7CC" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsCustomColor}" Value="True">
                                                    <Setter TargetName="Ring" Property="BorderBrush" Value="#F5F5F7" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsRange, Converter={StaticResource VisibleWhen}}">
                                <Slider Style="{StaticResource Range}" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Value}"
                                        AutomationProperties.Name="{Binding Label}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ValueText}" Width="38" Margin="12,0,0,0" TextAlignment="Right"
                                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <!-- Custom bar colour: a #RRGGBB field under the row; Enter or leaving it keeps a valid code, Esc cancels. -->
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding IsEditingColor, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="Color code" Foreground="#8E8E93" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Style="{StaticResource Field}" Width="110" MaxLength="7" Text="{Binding ColorCode, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Color code" IsVisibleChanged="OnCityFieldShown" PreviewKeyDown="OnColorKey"
                                     LostKeyboardFocus="OnColorFieldLostFocus" />
                        </StackPanel>
                        <!-- The places found for the city search, under the row; a message when there are none. -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" Visibility="{Binding IsSearchingCity, Converter={StaticResource VisibleWhen}}">
                            <TextBlock Text="{Binding CityMessage}" FontSize="11.5" Foreground="#8E8E93" Margin="0,2" />
                            <ItemsControl ItemsSource="{Binding CityResults}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding PickCommand}" Content="{Binding Display}" AutomationProperties.Name="{Binding Display}"
                                                FocusVisualStyle="{StaticResource FocusRing}" Cursor="Hand" HorizontalContentAlignment="Left">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" Padding="10,6" CornerRadius="6" Background="Transparent">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#2C2C2E" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#2C2C2E" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <!-- System modules reorder by this grip (mockup .sgrip) or Alt + Up/Down on their switch. -->
                        <Border DockPanel.Dock="Left" Background="Transparent" Cursor="SizeNS" Margin="-4,0,8,0" Padding="0,6"
                                ToolTip="Drag to reorder" Visibility="{Binding CanReorder, Converter={StaticResource VisibleWhen}}"
                                MouseLeftButtonDown="OnGripDown" MouseMove="OnGripMove" MouseLeftButtonUp="OnGripUp" LostMouseCapture="OnGripLost">
                            <c:IconView Glyph="{StaticResource Icon.Grip}" Filled="True" Width="14" Height="14" Foreground="#8E8E93" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Note}" FontSize="11.5" Foreground="#8E8E93" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasNote, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Row" Property="IsEnabled" Value="False">
                        <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Border BorderBrush="#14FFFFFF" BorderThickness="1">
        <DockPanel>
            <!-- Title bar (mockup .stb): drawn by Gili, dragged through WindowChrome's caption. -->
            <DockPanel DockPanel.Dock="Top" Height="36" Background="#2B2B2B">
                <Button DockPanel.Dock="Right" Style="{StaticResource CloseButton}" Click="OnClose" IsTabStop="False"
                        WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.Name="Close Settings">
                    <c:IconView Glyph="{StaticResource Icon.Close}" Width="14" Height="14" />
                </Button>
                <c:IconView Glyph="{StaticResource Icon.Gear}" Width="14" Height="14" Margin="12,0,8,0" Foreground="#C7C7CC" />
                <TextBlock Text="Gili Settings" FontSize="12" Foreground="#C7C7CC" VerticalAlignment="Center" />
            </DockPanel>

            <Border DockPanel.Dock="Left" Width="150" BorderBrush="#0FFFFFFF" BorderThickness="0,0,1,0">
                <ListBox x:Name="Nav" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" DisplayMemberPath="Name"
                         Background="Transparent" BorderThickness="0" Padding="8"
                         AutomationProperties.Name="Settings sections">
                    <ListBox.ItemContainerStyle>
                        <!-- Each section reads by its name, not by its record's text. -->
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ItemsPresenter Margin="{TemplateBinding Padding}" />
                        </ControlTemplate>
                    </ListBox.Template>
                </ListBox>
            </Border>

            <ScrollViewer x:Name="Page" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedSection.Name}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ItemsControl x:Name="RowList" ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}" Focusable="False">
                        <ItemsControl.ItemContainerStyle>
                            <!-- Each row reads by its name, not by its view model's type. -->
                            <Style TargetType="ContentPresenter">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
